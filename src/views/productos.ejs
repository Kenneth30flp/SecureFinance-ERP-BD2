<%- include('partials/kenneth-head',{actual:'productos',title:'Productos',eyebrow:'Catálogo / Datos maestros',intro:'Productos, precios y condiciones de abastecimiento.',create:'PRODUCTOS_ADMINISTRAR'}) %>
<% const link=id=>'/productos?'+new URLSearchParams({buscar:f.buscar||'',vista:f.vista||'galeria',...(id?{id:String(id)}:{})}).toString(); %>
<%- include('partials/kenneth-search',{actual:'productos',label:'productos',placeholder:'SKU o descripción'}) %>
<% if(selected||f.nuevo){ %><a class="btn btn-outline-secondary editor-jump" href="#product-editor-title">Ir a la ficha del producto</a><% } %>
<nav class="catalog-toolbar" aria-label="Vista de productos"><span>Catálogo de productos</span><div class="view-switch"><a class="btn <%= f.vista==='tabla'?'btn-primary':'btn-outline-secondary' %>" href="?<%= new URLSearchParams({buscar:f.buscar||'',vista:'tabla',...(selected?{id:String(selected.ProductoId)}:{})}).toString() %>" <%- f.vista==='tabla'?'aria-current="true"':'' %>>Tabla</a><a class="btn <%= f.vista!=='tabla'?'btn-primary':'btn-outline-secondary' %>" href="?<%= new URLSearchParams({buscar:f.buscar||'',vista:'galeria',...(selected?{id:String(selected.ProductoId)}:{})}).toString() %>" <%- f.vista!=='tabla'?'aria-current="true"':'' %>>Galería</a></div></nav>
<div class="catalog-layout <%= selected||f.nuevo?'with-editor':'' %>"><section aria-label="Catálogo de productos">
<% if(f.vista==='tabla'){ %><div class="master-table-scroll"><table class="table master-table product-table"><caption class="visually-hidden">Catálogo empresarial de productos</caption><thead><tr><th scope="col">SKU</th><th scope="col">Producto</th><th scope="col">Proveedor</th><% if(usuario.permisos.includes('PRODUCTOS_ADMINISTRAR')){ %><th scope="col" class="text-end">Costo Q</th><% } %><th scope="col" class="text-end">Venta Q</th><th scope="col" class="text-end">Stock</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody><% rows.forEach(p=>{ %><tr data-record-id="<%= p.ProductoId %>" class="<%= selected?.ProductoId===p.ProductoId?'is-selected':'' %>"><td class="master-code"><%= p.Codigo %></td><th scope="row"><a href="<%= link(p.ProductoId) %>"><%= p.Descripcion %></a></th><td><%= p.Proveedor||'Sin proveedor asignado' %></td><% if(usuario.permisos.includes('PRODUCTOS_ADMINISTRAR')){ %><td class="text-end"><%= p.PrecioCosto==null?'Sin registrar':Number(p.PrecioCosto).toFixed(2) %></td><% } %><td class="text-end"><%= Number(p.Precio).toFixed(2) %></td><td class="text-end"><%= p.Stock %></td><td><span class="master-status <%= p.Activo?'is-active':'is-inactive' %>"><%= p.Activo?'Activo':'Inactivo' %></span></td><td><a href="<%= link(p.ProductoId) %>"><%= usuario.permisos.includes('PRODUCTOS_ADMINISTRAR')?'Editar':'Consultar' %><span class="visually-hidden"> <%= p.Descripcion %></span></a></td></tr><% }); %></tbody></table></div><% } else { %><div class="catalog-grid">
<% rows.forEach(p=>{ %><article class="catalog-item <%= selected?.ProductoId===p.ProductoId?'is-selected':'' %>"><a class="catalog-media" href="<%= link(p.ProductoId) %>" aria-label="Consultar <%= p.Descripcion %>"><% if(p.Fotografia){ %><img src="/fotografias/<%= p.Fotografia %>" alt="<%= p.Descripcion %>" loading="lazy"><% } else { %><span class="photo-empty"><%- include('partials/icon',{nombre:'box'}) %><span>Sin fotografía</span></span><% } %></a><div class="catalog-copy"><span class="master-code"><%= p.Codigo %></span><h2><a href="<%= link(p.ProductoId) %>"><%= p.Descripcion %></a></h2><p><%= p.Proveedor||'Sin proveedor asignado' %></p><div class="catalog-bottom"><strong>Q <%= Number(p.Precio).toFixed(2) %></strong><span><%= p.Stock %> unidades</span></div><span class="master-status <%= p.Activo?'is-active':'is-inactive' %>"><%= p.Activo?'Activo':'Inactivo' %></span><a class="btn btn-outline-secondary catalog-edit" href="<%= link(p.ProductoId) %>"><%= usuario.permisos.includes('PRODUCTOS_ADMINISTRAR')?'Editar producto':'Consultar producto' %></a></div></article><% }); %></div>
<% } %><% if(!rows.length){ %><div class="master-empty"><h2><%= f.buscar?'No hay coincidencias':'Aún no hay productos registrados' %></h2><p>Los productos registrados aparecerán aquí. Puedes buscar por SKU o descripción.</p></div><% } %>
<%- include('partials/kenneth-pagination',{label:'productos'}) %></section>
<% if(selected||f.nuevo){ const p=selected||{}; const edit=usuario.permisos.includes('PRODUCTOS_ADMINISTRAR'); %><aside class="master-editor" aria-labelledby="product-editor-title"><div class="editor-heading"><div><p class="eyebrow"><%= selected?'Ficha de producto':'Alta de catálogo' %></p><h2 id="product-editor-title" tabindex="-1"><%= selected?p.Codigo:'Nuevo producto' %></h2></div><a class="btn btn-link" href="/productos">Cerrar</a></div>
<% if(selected&&p.Activo&&usuario.permisos.includes('INVENTARIO_REGISTRAR')&&usuario.permisos.includes('INVENTARIO_CONSULTAR')){ %><a class="btn btn-primary" href="/inventario?id=<%= p.ProductoId %>#inventory-detail">Ingresar existencias</a><% } %><% if(selected&&usuario.permisos.includes('INVENTARIO_CONSULTAR')){ %><a class="btn btn-outline-secondary" href="/inventario?id=<%= p.ProductoId %>#inventory-detail">Consultar Kardex</a><% } %><% if(edit){ %><form method="post" data-master-form data-success="/productos?id=" action="/productos<%= selected?'/'+p.ProductoId:'' %>"><input type="hidden" name="Version" value="<%= p.Version||'' %>"><input type="hidden" name="UploadToken" value="">
<div class="form-grid"><%- include('partials/kenneth-field',{name:'Codigo',label:'SKU / Código',value:p.Codigo,max:40}) %><%- include('partials/kenneth-field',{name:'Descripcion',label:'Descripción',value:p.Descripcion,max:200}) %><%- include('partials/kenneth-field',{name:'PrecioCosto',label:'Costo (Q)',value:p.PrecioCosto??'0.00',type:'number',step:'.01',limit:'9999999999.99'}) %><%- include('partials/kenneth-field',{name:'Precio',label:'Venta (Q)',value:p.Precio??'0.00',type:'number',step:'.01',limit:'9999999999.99'}) %></div>
<fieldset class="supplier-picker"><legend>Proveedor</legend><label for="supplier-search">Buscar por nombre o NIT</label><div class="inline-controls"><input id="supplier-search" class="form-control" maxlength="150" type="search"><button type="button" class="btn btn-outline-secondary" id="supplier-find" <%= usuario.permisos.includes('PROVEEDORES_CONSULTAR')?'':'disabled' %>>Buscar</button></div><label for="ProveedorId">Proveedor asociado</label><select class="form-select" name="ProveedorId" id="ProveedorId" required><option value="">Selecciona un proveedor</option><% if(p.ProveedorId&&!suppliers.some(s=>s.ProveedorId===p.ProveedorId)){ %><option value="<%= p.ProveedorId %>" selected><%= p.Proveedor||'Proveedor '+p.ProveedorId %></option><% } %><% suppliers.filter(s=>s.Activo||s.ProveedorId===p.ProveedorId).forEach(s=>{ %><option data-inactive="<%= !s.Activo %>" value="<%= s.ProveedorId %>" <%= s.ProveedorId===p.ProveedorId?'selected':'' %>><%= s.Nombre %><%= s.Activo?'':' · Inactivo' %></option><% }); %></select><small>Busca para consultar otros proveedores. Solo se puede guardar con un proveedor activo.</small><% if(!usuario.permisos.includes('PROVEEDORES_CONSULTAR')){ %><p class="alert alert-warning">Necesitas PROVEEDORES_CONSULTAR para buscar proveedores.</p><% } %></fieldset>
<div class="form-grid"><%- include('partials/kenneth-field',{name:'StockMinimo',label:'Stock mínimo',value:p.StockMinimo??5,type:'number'}) %><%- include('partials/kenneth-field',{name:'PuntoReorden',label:'Punto de reorden',value:p.PuntoReorden??5,type:'number'}) %><%- include('partials/kenneth-field',{name:'GarantiaMeses',label:'Garantía (meses)',value:p.GarantiaMeses??0,type:'number',limit:32767}) %><div class="stock-readonly"><span>Existencia actual</span><strong><%= p.Stock??0 %></strong><small>Se modifica desde Inventario.</small></div></div>
<fieldset class="photo-uploader"><legend>Fotografía del producto</legend><% if(p.Fotografia){ %><img class="photo-preview" id="photo-preview" src="/fotografias/<%= p.Fotografia %>" alt="Fotografía actual"><% } else { %><img class="photo-preview" id="photo-preview" alt="Vista previa de la fotografía" hidden><% } %><label for="product-photo">Seleccionar fotografía PNG o JPEG</label><input class="form-control" type="file" id="product-photo" accept="image/png,image/jpeg"><small>Opcional · máximo 3 MB · se valida y recodifica en servidor.</small><button type="button" id="cancel-photo" class="btn btn-link" hidden>Cancelar carga</button><% if(p.Fotografia){ %><label class="check-line"><input type="checkbox" name="QuitarFotografia"> Quitar fotografía actual</label><% } %><p id="photo-status" role="status" aria-live="polite"></p></fieldset>
<% if(selected){ %><label for="Activo">Estado</label><select class="form-select" name="Activo" id="Activo"><option value="1" <%= p.Activo?'selected':'' %>>Activo</option><option value="0" <%= !p.Activo?'selected':'' %>>Inactivo</option></select><% } %><% if(!suppliers.some(s=>s.Activo)){ %><p class="supplier-warning" role="status">No hay proveedores activos disponibles en el selector. Busca otro proveedor<% if(usuario.permisos.includes('PROVEEDORES_ADMINISTRAR')){ %> o <a href="/proveedores?nuevo=1">registra uno en Proveedores</a><% } %> antes de guardar. La consulta de productos históricos sigue disponible.</p><% } %><div class="form-feedback" role="status" aria-live="polite" tabindex="-1" hidden></div><div class="editor-actions"><a class="btn btn-outline-secondary" href="<%= link(null) %>">Cancelar</a><button class="btn btn-primary" type="submit" data-requires-supplier <%= suppliers.some(s=>s.Activo)?'':'disabled' %>>Guardar producto</button></div></form>
<% } else { %><dl class="master-facts"><dt>Descripción</dt><dd><%= p.Descripcion %></dd><dt>Proveedor</dt><dd><%= p.Proveedor||'Sin asignación' %></dd><dt>Precio de venta</dt><dd>Q <%= Number(p.Precio).toFixed(2) %></dd><dt>Existencia / mínimo / reorden</dt><dd><%= p.Stock %> / <%= p.StockMinimo %> / <%= p.PuntoReorden %></dd><dt>Garantía</dt><dd><%= p.GarantiaMeses %> meses</dd><dt>Estado</dt><dd><%= p.Activo?'Activo':'Inactivo' %></dd></dl><% } %><% if(selected){ %><%- include('partials/product-suppliers',{p}) %><% } %></aside><% } %></div></main></body></html>
