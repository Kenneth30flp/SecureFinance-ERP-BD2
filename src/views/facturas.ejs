<%- include('partials/facturas-head',{title:'Historial de facturas'}) %>
<% const link=pagina=>'/facturacion/historial?'+new URLSearchParams({...(f.numero?{numero:String(f.numero)}:{}),cliente:f.cliente,desde:f.desde,hasta:f.hasta,pagina:String(pagina)}); %>
<section class="work-panel invoice-filters"><div class="panel-body"><h2>Buscar facturas emitidas</h2>
<form method="get" action="/facturacion/historial" class="invoice-filter-grid"><div><label for="invoice-number">Número de factura</label><input class="form-control" type="number" min="1" max="2147483647" name="numero" id="invoice-number" value="<%= f.numero||'' %>"></div>
<div><label for="invoice-client">Cliente o NIT de emisión</label><input class="form-control" name="cliente" id="invoice-client" maxlength="150" value="<%= f.cliente %>"></div>
<div><label for="invoice-from">Desde · Guatemala</label><input class="form-control" type="date" name="desde" id="invoice-from" value="<%= f.desde %>"></div>
<div><label for="invoice-until">Hasta · Guatemala</label><input class="form-control" type="date" name="hasta" id="invoice-until" value="<%= f.hasta %>"></div>
<div class="invoice-filter-actions"><button class="btn btn-primary">Buscar</button><a class="btn btn-outline-secondary" href="/facturacion/historial">Limpiar</a></div></form>
<p class="summary-note">Los filtros incluyen el día final completo en America/Guatemala (UTC−6). Importes históricos en quetzales.</p></div></section>
<% if(error){ %><p class="alert alert-danger" role="alert"><%= error %></p><% }else{ %>
<section class="work-panel"><div class="panel-body"><div class="invoice-register-heading"><h2>Facturas emitidas</h2><span><%= rows.length?total+' resultados':'Sin resultados en esta página' %> · Página <%= f.pagina %></span></div>
<% if(rows.length){ %><div class="table-responsive invoice-history-scroll" tabindex="0" role="region" aria-label="Facturas emitidas"><table class="table table-modern align-middle invoice-history-table"><caption>Documentos existentes. Consultar o imprimir una copia no registra otra venta.</caption><thead><tr><th>Número</th><th>Fecha · Guatemala</th><th>Cliente / NIT histórico</th><th>Responsable</th><th>Subtotal Q</th><th>Descuento Q</th><th>IVA Q</th><th>Total Q</th><th>Estado documental</th><th>Comprobante</th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr data-invoice="<%= r.FacturaId %>"><th scope="row">#<%= r.FacturaId %></th><td><%- include('partials/operational-date',{value:r.FechaHora}) %></td><td><strong><%= r.Cliente||'Sin nombre registrado al emitir' %></strong><br><small><%= r.NIT||'Sin NIT registrado al emitir' %></small></td><td><%= r.Responsable %></td><td><%= r.Subtotal %></td><td><%= r.Descuento %></td><td><%= r.IVA %></td><td><strong><%= r.Total %></strong></td><td><span class="status-badge"><%= r.Estado %></span></td><td><a class="btn btn-outline-secondary btn-sm" href="/facturacion/facturas/<%= r.FacturaId %>">Ver comprobante</a><a class="btn btn-link btn-sm" href="/facturacion/facturas/<%= r.FacturaId %>?imprimir=1">Imprimir copia</a></td></tr><% }); %>
</tbody></table></div><% }else{ %><div class="empty-state"><h3>No hay facturas para esta búsqueda</h3><p>Cambia los filtros o consulta otra página. Las facturas existentes se conservan.</p></div><% } %>
<nav class="invoice-pagination" aria-label="Páginas del historial"><% if(f.pagina>1){ %><a class="btn btn-outline-secondary" href="<%= link(f.pagina-1) %>">Anterior</a><% } %><span>Página <%= f.pagina %></span><% if(f.pagina*20<total){ %><a class="btn btn-outline-secondary" href="<%= link(f.pagina+1) %>">Siguiente</a><% } %></nav>
</div></section><% } %></main></body></html>
