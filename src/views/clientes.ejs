<%- include('partials/kenneth-head',{actual:'clientes',title:'Clientes',eyebrow:'Relaciones comerciales / Clientes',intro:'Directorio, contacto e identidad fiscal.',create:'CLIENTES_REGISTRAR'}) %>
<% const link=(id,extra={})=>'/clientes?'+new URLSearchParams({buscar:f.buscar||'',offset:String(f.offset||0),...(id?{id:String(id)}:{}),...extra}).toString(); const closeLink=link(selected?.ClienteId); %>
<%- include('partials/kenneth-search',{actual:'clientes',label:'clientes',placeholder:'Nombre o NIT'}) %>
<div class="customer-layout"><section aria-label="Directorio de clientes"><div class="section-heading"><h2>Directorio de clientes</h2><%- include('partials/kenneth-state-filter') %></div>
<div class="master-table-scroll"><table class="table master-table"><caption class="visually-hidden">Clientes y contacto</caption><thead><tr><th scope="col">Cliente / contacto</th><th scope="col">NIT</th><th scope="col">Estado</th></tr></thead><tbody><% rows.forEach(c=>{ %><tr data-record-id="<%= c.ClienteId %>" data-record-state="<%= c.Activo?'activo':'inactivo' %>" class="<%= selected?.ClienteId===c.ClienteId?'is-selected':'' %>"><th scope="row"><a href="<%= link(c.ClienteId) %>" <%- selected?.ClienteId===c.ClienteId?'aria-current="true"':'' %>><%= c.Nombre %></a><small><%= c.Correo||c.Telefono||'Sin contacto registrado' %></small></th><td class="master-code"><%= c.NIT %></td><td><span class="master-status <%= c.Activo?'is-active':'is-inactive' %>"><%= c.Activo?'Activo':'Inactivo' %></span></td></tr><% }); %></tbody></table></div>
<% if(!rows.length){ %><div class="master-empty"><h2><%= f.buscar||f.offset?'Sin clientes coincidentes':'Aún no hay clientes registrados' %></h2><p><%= f.buscar||f.offset?'Prueba otro nombre o NIT, o limpia la búsqueda.':'Registra una identidad fiscal y sus datos de contacto para comenzar.' %></p><% if(!f.buscar&&!f.offset&&usuario.permisos.includes('CLIENTES_REGISTRAR')){ %><a class="btn btn-primary" href="<%= link(null,{nuevo:'1'}) %>">Registrar primer cliente</a><% } %></div><% } %><p data-state-empty hidden class="master-empty">No hay clientes con este estado en esta página.</p><%- include('partials/kenneth-pagination',{label:'clientes'}) %></section>
<a class="btn btn-outline-secondary record-detail-jump" href="#customer-detail">Ver ficha seleccionada</a><aside id="customer-detail" class="customer-identity"><% if(selected){const c=selected; %><p class="eyebrow">Ficha de cliente</p><div class="identity-heading"><span class="identity-avatar" aria-hidden="true"><%- include('partials/icon',{nombre:'user'}) %></span><div><h2><%= c.Nombre %></h2><span class="master-status <%= c.Activo?'is-active':'is-inactive' %>"><%= c.Activo?'Activo':'Inactivo' %></span></div></div><div class="fiscal-number"><span>NIT vigente</span><strong><%= c.NIT %></strong></div><dl class="master-facts"><dt>Correo</dt><dd><%= c.Correo||'Sin registro' %></dd><dt>Teléfono</dt><dd><%= c.Telefono||'Sin registro' %></dd><dt>Registro</dt><dd><%- include('partials/operational-date',{value:c.FechaCreacion,dateOnly:true}) %> Guatemala (UTC−6)</dd><% if(!c.Activo&&c.FechaInactivacion){ %><dt>Inactivación</dt><dd><%- include('partials/operational-date',{value:c.FechaInactivacion}) %> Guatemala (UTC−6)</dd><dt>Motivo</dt><dd><%= c.MotivoInactivacion||'Sin motivo disponible' %></dd><% } %></dl>
<details class="record-technical"><summary>Detalle técnico</summary><span>ClienteId: <%= c.ClienteId %></span></details><div class="context-toolbar"><% if(usuario.permisos.includes('CLIENTES_EDITAR')){ %><a class="btn btn-outline-secondary" href="<%= link(c.ClienteId,{editar:'1'}) %>">Editar datos</a><% } %><% if(usuario.permisos.includes('AUDITORIA_CONSULTAR')){ %><a class="btn btn-link" href="/auditoria?vista=ventas&amp;cliente=<%= encodeURIComponent(c.Nombre) %>">Consultar historial de ventas</a><% } %></div>
<% if(usuario.permisos.includes('CLIENTES_ACTUALIZAR_NIT')){ %><details class="context-action"><summary>Cambiar NIT</summary><p>La modificación fiscal requiere motivo y conserva la trazabilidad.</p><form method="post" data-master-form data-success="/clientes?id=" action="/clientes/<%= c.ClienteId %>/nit"><input type="hidden" name="Version" value="<%= c.Version %>"><%- include('partials/kenneth-field',{name:'NIT',label:'Nuevo NIT',value:c.NIT,max:25}) %><%- include('partials/kenneth-field',{name:'Motivo',label:'Motivo del cambio fiscal',value:'',max:250}) %><button type="submit" class="btn btn-primary">Actualizar NIT</button></form></details><% } %>
<% if(c.Activo&&usuario.permisos.includes('CLIENTES_INACTIVAR')){ %><details class="context-action"><summary>Inactivar cliente</summary><p>Impide nuevas ventas. Conserva el cliente y sus facturas históricas.</p><form method="post" data-master-form data-confirm="¿Inactivar este cliente? Sus facturas se conservarán y no podrá recibir nuevas ventas." data-success="/clientes?id=" action="/clientes/<%= c.ClienteId %>/inactivar"><input type="hidden" name="Version" value="<%= c.Version %>"><%- include('partials/kenneth-field',{name:'Motivo',label:'Motivo de inactivación',value:'',max:250,controlId:'MotivoInactivar'}) %><button type="submit" class="btn btn-outline-danger">Inactivar cliente</button></form></details><% } %><p class="governance-copy">Las facturas históricas conservan su referencia al cliente. El cambio fiscal se registra por separado de los datos de contacto.</p><% } else { %><div class="master-empty"><h2>Ficha de cliente</h2><p>Selecciona un registro del directorio para consultar sus datos y acciones disponibles.</p></div><% } %></aside></div>
<% const editing=selected&&f.editar&&usuario.permisos.includes('CLIENTES_EDITAR'),creating=f.nuevo&&usuario.permisos.includes('CLIENTES_REGISTRAR'); if(editing||creating){const c=editing?selected:{}; %>
<dialog class="master-drawer" data-auto-open aria-labelledby="client-editor-title" data-close-url="<%= closeLink %>"><div class="drawer-heading"><div><p class="eyebrow"><%= editing?'Datos de contacto':'Alta de cliente' %></p><h2 id="client-editor-title"><%= editing?'Editar datos':'Nuevo cliente' %></h2></div><a class="btn btn-outline-secondary" href="<%= closeLink %>">Cerrar</a></div><p class="drawer-intro"><%= editing?'Actualiza el contacto. Para modificar el NIT utiliza Cambiar NIT en la ficha.':'Registra la identidad fiscal y el contacto. Los campos con * son obligatorios.' %></p>
<form method="post" data-master-form data-success="/clientes?id=" action="/clientes<%= editing?'/'+c.ClienteId+'/datos':'' %>"><% if(editing){ %><input type="hidden" name="Version" value="<%= c.Version %>"><p class="readonly-identity">NIT <strong><%= c.NIT %></strong></p><% } else { %><%- include('partials/kenneth-field',{name:'NIT',label:'NIT *',value:'',max:25,controlId:'ClienteNIT'}) %><% } %>
<%- include('partials/kenneth-field',{name:'Nombre',label:'Nombre completo / razón social *',value:c.Nombre,max:150}) %><%- include('partials/kenneth-field',{name:'Correo',label:'Correo electrónico',value:c.Correo,max:254,type:'email',required:false}) %><%- include('partials/kenneth-field',{name:'Telefono',label:'Teléfono',value:c.Telefono,max:25,type:'tel',required:false}) %><div class="form-feedback" role="status" aria-live="polite" tabindex="-1" hidden></div><div class="editor-actions"><a class="btn btn-outline-secondary" href="<%= closeLink %>">Cancelar</a><button class="btn btn-primary" type="submit"><%= editing?'Guardar cambios':'Registrar cliente' %></button></div></form></dialog><% } %>
<%- include('partials/kenneth-confirm') %></main></body></html>
