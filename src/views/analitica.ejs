<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Executive Analytics | SecureFinance ERP</title><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/executive-analytics.css"><script src="/js/analitica.js" defer></script></head>
<body class="app-shell"><a class="skip-link" href="#workspace">Ir al contenido</a>
<%- include('partials/navigation',{actual,rolesCuenta}) %>
<main id="workspace" tabindex="-1" class="container page-content executive-analytics">
  <header class="ea-heading"><div><p class="eyebrow">SecureFinance — inteligencia comercial</p><h1>EXECUTIVE ANALYTICS</h1><p>Ventas, clientes y abastecimiento calculados desde la base transaccional.</p></div><div class="ea-period"><span>Período consultado</span><strong><%= dashboard?.kpis?.PeriodoDesdeLocal || 'Sin resultados' %> → <%= dashboard?.kpis?.PeriodoHastaLocal || '' %></strong><small>Jornada Guatemala · UTC−6</small></div></header>
  <form class="ea-filters" data-analytics-filter method="get" action="/analitica">
    <label>Período<select name="modo"><option value="DIARIO" <%= filtros.modo==='DIARIO'?'selected':'' %>>Diario</option><option value="SEMANAL" <%= filtros.modo==='SEMANAL'?'selected':'' %>>Semanal</option><option value="MENSUAL" <%= filtros.modo==='MENSUAL'?'selected':'' %>>Mensual</option><option value="RANGO" <%= filtros.modo==='RANGO'?'selected':'' %>>Rango personalizado</option></select></label>
    <label>Desde<input type="date" name="fechaDesde" value="<%= filtros.fechaDesde||'' %>"></label>
    <label>Hasta<input type="date" name="fechaHasta" value="<%= filtros.fechaHasta||'' %>"></label>
    <button class="btn btn-primary" type="submit">Actualizar analítica</button>
  </form>
  <p class="ea-state" data-analytics-state hidden role="status" aria-live="polite"></p>
  <% if(error){ %><p class="ea-state ea-error" role="alert"><%= error %></p><% } %>
  <% if(dashboard){ const k=dashboard.kpis; const money=v=>`Q ${v||'0.00'}`; %>
  <section class="ea-kpis" aria-label="Indicadores financieros">
    <div class="ea-kpi"><span>Ventas del rango</span><strong><%= money(k.VentasRango) %></strong><small><%= k.PeriodoDesdeLocal %> a <%= k.PeriodoHastaLocal %></small></div>
    <div class="ea-kpi"><span>Ventas del día</span><strong><%= money(k.VentasDia) %></strong><small>Jornada local actual</small></div>
    <div class="ea-kpi"><span>Ventas del mes</span><strong><%= money(k.VentasMes) %></strong><small>Mes local actual</small></div>
    <div class="ea-kpi"><span>Ticket promedio</span><strong><%= money(k.TicketPromedio) %></strong><small><%= k.FacturasRango %> facturas · <%= k.UnidadesVendidas %> unidades</small></div>
  </section>
  <div class="ea-grid">
    <section class="ea-panel" aria-labelledby="products-title"><header><h2 id="products-title">Productos más vendidos</h2><span>Importe histórico neto</span></header><div class="ea-table-wrap"><% if(!dashboard.productos.length){ %><p class="ea-empty">No hay ventas en el período seleccionado.</p><% }else{ %><table class="ea-table"><caption class="visually-hidden">Ranking de productos vendidos</caption><thead><tr><th>Pos.</th><th>Producto</th><th>Unidades</th><th>Importe</th></tr></thead><tbody><% dashboard.productos.forEach(p=>{ %><tr><td><%= p.Ranking %></td><td><strong><%= p.Producto %></strong><small><%= p.SKU %> · <%= p.NumeroFacturas %> facturas</small></td><td><%= p.UnidadesVendidas %></td><td>Q <%= p.ImporteVendido %></td></tr><% }); %></tbody></table><% } %></div></section>
    <section class="ea-panel" aria-labelledby="clients-title"><header><h2 id="clients-title">Clientes frecuentes</h2><span>Compras únicas por factura</span></header><div class="ea-table-wrap"><% if(!dashboard.clientes.length){ %><p class="ea-empty">No hay compras de clientes en el período.</p><% }else{ %><table class="ea-table"><caption class="visually-hidden">Clientes frecuentes del período</caption><thead><tr><th>Cliente</th><th>Clasificación</th><th>Compras</th><th>Total</th></tr></thead><tbody><% dashboard.clientes.forEach(c=>{ %><tr><td><strong><%= c.NombreCliente %></strong><small><%= c.Activo?'Cuenta activa':'Cuenta inactiva · historial conservado' %></small></td><td><span class="ea-badge"><%= c.Clasificacion %></span></td><td><%= c.NumeroCompras %></td><td>Q <%= c.TotalHistoricoComprado %></td></tr><% }); %></tbody></table><% } %></div></section>
    <section class="ea-panel ea-panel-wide" aria-labelledby="stock-title"><header><h2 id="stock-title">Productos por comprar</h2><span>Regla: máximo entre punto de reorden − stock y cero</span></header><div class="ea-table-wrap"><% if(!dashboard.abastecimiento.length){ %><p class="ea-empty">No hay productos activos con necesidad de compra.</p><% }else{ %><table class="ea-table"><caption class="visually-hidden">Productos que requieren abastecimiento</caption><thead><tr><th>Producto</th><th>Proveedor</th><th>Stock</th><th>Mínimo / reorden</th><th>Déficit</th><th>Sugerencia</th><th>Estado</th></tr></thead><tbody><% dashboard.abastecimiento.forEach(p=>{ %><tr><td><strong><%= p.Producto %></strong><small><%= p.SKU %></small></td><td><%= p.Proveedor||'Proveedor pendiente' %></td><td><%= p.Stock %></td><td><%= p.StockMinimo %> / <%= p.PuntoReorden %></td><td><%= p.Deficit %></td><td><%= p.CantidadSugerida %></td><td><span class="ea-badge warn"><%= p.EstadoAbastecimiento %></span></td></tr><% }); %></tbody></table><% } %></div></section>
    <section class="ea-panel ea-panel-wide" aria-labelledby="guarantee-title"><header><h2 id="guarantee-title">Estado de garantías</h2><span>Tickets abiertos en el período · estado actual</span></header><div class="ea-guarantees"><% const g=dashboard.garantias[0]; if(g?.Integrado){ %><div class="ea-guarantee-states"><% dashboard.garantias.forEach(ticket=>{ %><span class="ea-badge"><%= ticket.Estado %>: <strong><%= ticket.Cantidad %></strong></span><% }); %></div><% }else{ %><p><%= g?.Mensaje || 'Métricas de garantías no disponibles.' %></p><% } %></div></section>
  </div>
  <% const hasNext = dashboard.productos.length === filtros.limite || dashboard.clientes.length === filtros.limite || dashboard.abastecimiento.length === filtros.limite; const linkFor = page => '/analitica?modo='+encodeURIComponent(filtros.modo)+(filtros.fechaDesde?'&fechaDesde='+encodeURIComponent(filtros.fechaDesde):'')+(filtros.fechaHasta?'&fechaHasta='+encodeURIComponent(filtros.fechaHasta):'')+'&pagina='+page; %>
  <nav class="ea-pagination" aria-label="Paginación de resultados"><% if(filtros.pagina>1){ %><a class="btn btn-outline-secondary" href="<%= linkFor(filtros.pagina-1) %>">Página anterior</a><% } %><span>Página <%= filtros.pagina %></span><% if(hasNext){ %><a class="btn btn-outline-secondary" href="<%= linkFor(filtros.pagina+1) %>">Página siguiente</a><% } %></nav>
  <% } else if(!error){ %><p class="ea-state">Sin datos disponibles para mostrar.</p><% } %>
</main></body></html>
