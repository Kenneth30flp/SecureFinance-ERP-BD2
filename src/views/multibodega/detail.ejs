<%- include('head',{title:'Transferencia TR-'+row.TransferenciaId,section:'transferencias'}) %>
<div class="bod-actions bod-no-print"><a href="/multibodega?seccion=transferencias">Volver al historial</a><button type="button" class="btn btn-outline-primary" data-bod-print>Imprimir evidencia</button></div>
<article class="bod-panel bod-document"><header><div><p class="eyebrow">COMPROBANTE INTERNO / SOLO LECTURA</p><h2>TR-<%= row.TransferenciaId %></h2></div><span class="bod-state"><%= row.Estado %></span></header>
<div class="bod-route"><div><small>ORIGEN #<%= row.OrigenId %></small><strong><%= row.Origen %></strong></div><span aria-hidden="true">&rarr;</span><div><small>DESTINO #<%= row.DestinoId %></small><strong><%= row.Destino %></strong></div><div class="bod-units"><strong><%= row.Cantidad %></strong><small>UNIDADES</small></div></div>
<dl class="bod-meta"><div><dt>Producto</dt><dd>#<%= row.ProductoId %> / <%= row.Codigo %><br><%= row.Descripcion %></dd></div><div><dt>Propuesta registrada</dt><dd><%= dates.formatDateTime(row.FechaHora) %><small>Guatemala (UTC-6) / Actor #<%= row.ActorUsuarioId %></small></dd></div><div><dt>Motivo</dt><dd><%= row.Motivo %></dd></div><div><dt>Version actual</dt><dd><code><%= row.Version %></code></dd></div></dl>
<ol class="bod-phases"><li class="bod-ok"><strong>01 / PREPARADA</strong><span>Propuesta sin movimiento de stock</span></li><li class="<%= ['DESPACHADA','RECIBIDA'].includes(row.Estado)?'bod-ok':'' %>"><strong>02 / DESPACHADA</strong><span>Salida de origen hacia transito</span></li><li class="<%= row.Estado==='RECIBIDA'?'bod-ok':'' %>"><strong>03 / RECIBIDA</strong><span>Entrada en destino; transito cerrado</span></li></ol>
<h3 class="bod-evidence-title">Evidencia local inmutable</h3><% if(!evidence.length){ %><p class="bod-note">Sin movimientos: la propuesta no modifica stock.</p><% } %>
<% evidence.forEach(event=>{ %><section class="bod-event"><h3><%= event.Tipo %> / <%= event.Bodega %></h3><p><strong><%= event.Cantidad %> unidades</strong> / saldo <%= event.SaldoAnterior %> &rarr; <%= event.SaldoResultante %></p><p><%= event.Actor %> (#<%= event.ActorUsuarioId %>) / UTC <%= event.FechaHora instanceof Date?event.FechaHora.toISOString():event.FechaHora %></p><p><%= event.Motivo %></p><code><%= event.OperacionId %></code></section><% }); %>
<footer>Las transferencias no son ventas ni compras. No duplican movimientos en el Kardex global.</footer></article>
<% const action=row.Estado==='PREPARADA'?'despachar':row.Estado==='DESPACHADA'?'recibir':null; const permission=action==='despachar'?'TRANSFERENCIAS_DESPACHAR':'TRANSFERENCIAS_RECIBIR'; if(action&&usuario.permisos.includes(permission)){ %><section class="bod-panel bod-editor bod-no-print"><%- include('form',{flow:action+'-'+row.TransferenciaId,action:'/multibodega/transferencias/'+row.TransferenciaId+'/'+action,title:action==='despachar'?'Confirmar despacho':'Confirmar recepcion',submit:action==='despachar'?'Despachar a transito':'Recibir en destino',fields:[{name:'VersionEsperada',type:'hidden',value:row.Version},{name:'Motivo',label:'Motivo de la confirmacion',max:250}]}) %><p class="bod-note">Confirmacion atomica con version esperada. Una segunda recepcion con otra referencia se rechaza.</p></section><% } %>
</main></body></html>
