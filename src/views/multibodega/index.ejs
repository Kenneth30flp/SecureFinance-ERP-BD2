<%- include('head',{title:'Gestion multibodega',section}) %>
<% const can=p=>usuario.permisos.includes(p); const idField=(name,label)=>({name,label,type:'number'}); const reason={name:'Motivo',label:'Motivo documental',max:250}; %>
<% if(section==='inventario'){ const k=evidence[0]||{}; %>
<section class="bod-kpis" aria-label="Indicadores globales"><% for(const [key,label,hint] of [['StockGlobal','Stock del negocio','Incluye unidades en transito'],['StockLocal','En ubicaciones','Disponible para operaciones locales'],['Transito','En transito','Despachado, aun no recibido'],['Descuadres','Productos por revisar','Diferencia global - local - transito']]){ %><article><span><%= label %></span><strong><%= k[key]??'No disponible' %></strong><small><%= hint %></small></article><% } %></section>
<% } %>
<% if(section!=='integraciones'){ %><section class="bod-panel"><header><h2><%= ({inventario:'Conciliacion de existencias',bodegas:'Directorio operativo',transferencias:'Historial de transferencias',kardex:'Movimientos por ubicacion'})[section] %></h2><span>Pagina <%= f.pagina %></span></header>
<form method="get" class="bod-filters bod-no-print"><input type="hidden" name="seccion" value="<%= section %>">
<label>Bodega ID <input class="form-control" name="BodegaId" type="number" min="1" value="<%= f.BodegaId||'' %>"></label>
<label>SKU / nombre / codigo <input class="form-control" name="Buscar" maxlength="128" value="<%= f.Buscar||'' %>"></label>
<% if(section==='transferencias'){ %><label>Estado<select class="form-select" name="Estado"><option value="">Todos</option><% for(const state of ['PREPARADA','DESPACHADA','RECIBIDA']){ %><option value="<%= state %>" <%= f.Estado===state?'selected':'' %>><%= state %></option><% } %></select></label><% } %>
<% if(section!=='bodegas'){ %><label>Producto ID <input class="form-control" name="ProductoId" type="number" min="1" value="<%= f.ProductoId||'' %>"></label><% } %>
<% if(['kardex','transferencias'].includes(section)){ %><label>Desde (Guatemala)<input class="form-control" type="date" name="desde" value="<%= f.desde %>"></label><label>Hasta inclusive<input class="form-control" type="date" name="hasta" value="<%= f.hasta %>"></label><% } %>
<button class="btn btn-outline-primary">Aplicar filtros</button><a href="/multibodega?seccion=<%= section %>">Limpiar</a></form>
<% if(!rows.length){ %><p class="bod-empty">No hay registros para estos filtros. No se presentan datos simulados.</p><% }else{ %><div class="bod-scroll"><table class="bod-table"><caption class="visually-hidden"><%= section %></caption>
<% if(section==='inventario'){ %><thead><tr><th>Producto</th><th>Negocio</th><th>Ubicaciones</th><th>Transito</th><th>Bodega filtrada</th><th>Diferencia</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><th scope="row"><strong><%= row.Codigo %></strong><small>#<%= row.ProductoId %> / <%= row.Descripcion %></small></th><td data-label="Negocio"><%= row.Stock %></td><td data-label="Ubicaciones"><%= row.StockLocal %></td><td data-label="Transito"><%= row.Transito %></td><td data-label="Bodega filtrada"><%= f.BodegaId?(row.ExistenciaBodega??0):'Todas' %></td><td data-label="Diferencia" class="<%= String(row.Diferencia)==='0'?'bod-ok':'bod-warning' %>"><%= row.Diferencia %></td></tr><% }); %></tbody>
<% }else if(section==='bodegas'){ %><thead><tr><th>Bodega</th><th>Estado</th><th>Existencias</th><th>Administracion</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><th scope="row"><strong>#<%= row.BodegaId %> / <%= row.Nombre %></strong><small><%= row.Codigo||'Sin codigo' %> / <%= row.IsCentral?'Central predeterminada':'Ubicacion de negocio' %></small><small><%= row.Direccion||'Sin direccion' %> / <%= row.Responsable||'Sin responsable' %></small></th><td data-label="Estado"><%= row.Activo?'Activa':'Inactiva' %></td><td data-label="Existencias"><%= row.Stock %></td><td data-label="Administracion"><% if(can('BODEGAS_ADMINISTRAR')){ %><details><summary>Editar o inactivar</summary><%- include('form',{action:'/multibodega/bodegas/'+row.BodegaId,flow:'bodega-'+row.BodegaId,title:'Editar bodega',submit:'Guardar cambios',fields:[{name:'VersionEsperada',type:'hidden',value:row.Version},{name:'Nombre',label:'Nombre',value:row.Nombre,max:100},{name:'Codigo',label:'Codigo unico',value:row.Codigo||'',max:40,optional:true},{name:'Direccion',label:'Direccion',value:row.Direccion||'',max:250,optional:true},{name:'Responsable',label:'Responsable',value:row.Responsable||'',max:150,optional:true},{name:'Activo',label:'Estado',value:row.Activo?'1':'0',options:[['1','Activa'],['0','Inactiva']]},{name:'IsCentral',label:'Central predeterminada',value:row.IsCentral?'1':'0',options:[['0','No'],['1','Si']]},reason]}) %></details><% }else{ %>Solo lectura<% } %></td></tr><% }); %></tbody>
<% }else if(section==='transferencias'){ %><thead><tr><th>Transferencia</th><th>Recorrido</th><th>Cantidad</th><th>Fase</th><th>Fecha</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><th scope="row"><a href="/multibodega/transferencias/<%= row.TransferenciaId %>">TR-<%= row.TransferenciaId %></a><small><%= row.Codigo %> / <%= row.Descripcion %></small></th><td data-label="Recorrido"><%= row.Origen %> &rarr; <%= row.Destino %></td><td data-label="Cantidad"><%= row.Cantidad %></td><td data-label="Fase"><span class="bod-state"><%= row.Estado %></span></td><td data-label="Fecha"><%= dates.formatDateTime(row.FechaHora) %></td></tr><% }); %></tbody>
<% }else{ %><thead><tr><th>Movimiento</th><th>Ubicacion</th><th>Cantidad</th><th>Saldo</th><th>Actor / UTC</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><th scope="row"><strong><%= row.Tipo %></strong><small><%= row.Referencia %> / <%= row.Codigo %></small><small><%= row.Motivo %></small></th><td data-label="Ubicacion"><%= row.Bodega %></td><td data-label="Cantidad"><%= row.Cantidad %></td><td data-label="Saldo"><%= row.SaldoAnterior %> &rarr; <%= row.SaldoResultante %></td><td data-label="Actor / UTC"><%= row.Actor %><small><%= row.FechaHora instanceof Date?row.FechaHora.toISOString():row.FechaHora %></small><small class="bod-reference"><%= row.OperacionId %></small></td></tr><% }); %></tbody><% } %>
</table></div><% } %>
<nav class="bod-pagination bod-no-print" aria-label="Paginacion"><% const pageUrl=n=>'/multibodega?'+new URLSearchParams({seccion:section,pagina:String(n),BodegaId:f.BodegaId||'',ProductoId:f.ProductoId||'',Buscar:f.Buscar||'',Estado:f.Estado||'',desde:f.desde,hasta:f.hasta}).toString(); if(f.pagina>1){ %><a href="<%= pageUrl(f.pagina-1) %>">Anterior</a><% } %><span>Hasta 20 registros por pagina</span><% if(next){ %><a href="<%= pageUrl(f.pagina+1) %>">Siguiente</a><% } %></nav></section><% } %>
<% if(section==='inventario'){ %><p class="bod-note">El stock del negocio se conserva durante transferencias. Solo se vende existencia local, nunca unidades en camino. El snapshot inicial es un corte nuevo, no movimientos historicos reconstruidos.</p><% } %>
<% if(section==='bodegas'&&can('BODEGAS_ADMINISTRAR')){ %><section class="bod-panel bod-editor"><%- include('form',{action:'/multibodega/bodegas',flow:'nueva-bodega',title:'Registrar ubicacion',submit:'Crear bodega',fields:[{name:'Nombre',label:'Nombre de la bodega',max:100},{name:'Codigo',label:'Codigo unico (vacio: automatico)',max:40,optional:true},{name:'Direccion',label:'Direccion',max:250,optional:true},{name:'Responsable',label:'Responsable',max:150,optional:true},{name:'Activo',label:'Estado',options:[['1','Activa']]},{name:'IsCentral',label:'Central predeterminada',options:[['0','No'],['1','Si']]},reason]}) %><p class="bod-note">Inactivar es la baja logica. Se rechaza si conserva existencias o propuestas/despachos pendientes. Cambiar la central no mueve stock.</p></section><% } %>
<% if(section==='transferencias'&&can('TRANSFERENCIAS_CREAR')){ %><section class="bod-panel bod-editor"><%- include('form',{action:'/multibodega/transferencias',flow:'preparar',title:'01 / Preparar transferencia',submit:'Persistir propuesta',fields:[idField('ProductoId','Producto ID'),idField('OrigenId','Bodega origen ID'),idField('DestinoId','Bodega destino ID'),idField('Cantidad','Unidades enteras'),reason]}) %><p class="bod-note">Preparar no reserva ni mueve stock. El despacho vuelve a validar existencia y version.</p></section><% } %>
<% if(section==='integraciones'){ %><div class="bod-integration-grid">
<section class="bod-panel bod-editor"><% if(can('INVENTARIO_REGISTRAR')){ %><%- include('form',{action:'/multibodega/compras',flow:'compra',title:'Recepcion por bodega',submit:'Registrar recepcion',fields:[idField('BodegaId','Bodega de ingreso ID'),idField('ProductoId','Producto ID'),idField('ProveedorId','Proveedor ID'),idField('Cantidad','Unidades recibidas'),{name:'DocumentoRespaldo',label:'Documento de respaldo',max:100},{name:'CostoUnitario',label:'Costo unitario documental (opcional)',optional:true,max:20},reason]}) %><% }else{ %><h2>Recepciones</h2><p>Requiere INVENTARIO_REGISTRAR.</p><% } %><p class="bod-note">La recepcion oficial conserva el costo documental. Este wrapper calcula el promedio ponderado con costo conocido; si hay stock previo exige su costo conocido. Sin costo de recepcion no calcula promedio ni cambia PrecioCosto: conservar el valor anterior no significa valorar las unidades nuevas.</p></section>
<section class="bod-panel bod-editor"><% if(can('COTIZACIONES_CONVERTIR')&&can('VENTAS_REGISTRAR')){ %><%- include('form',{action:'/multibodega/cotizaciones/convertir',flow:'cotizacion',title:'Cotizacion con salida local',submit:'Convertir cotizacion',fields:[idField('CotizacionId','Cotizacion ID'),idField('BodegaId','Bodega de salida ID'),{name:'Credito',label:'Modalidad',options:[['0','Contado'],['1','Credito (requiere Modulo 3 instalado)']]},{name:'PlazoDias',label:'Plazo en dias (solo credito)',type:'number',optional:true},{name:'NumeroCuotas',label:'Numero de cuotas',type:'number',value:1}]}) %><% }else{ %><h2>Cotizaciones</h2><p>Requiere COTIZACIONES_CONVERTIR y VENTAS_REGISTRAR.</p><% } %><p class="bod-note">Los precios pactados vienen del motor de cotizaciones. Esta pantalla no recibe ni recalcula precios de venta. Credito no tiene dependencia para operar contado.</p></section></div><% } %>
</main></body></html>
