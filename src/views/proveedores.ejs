<%- include('partials/kenneth-head',{actual:'proveedores',title:'Proveedores',eyebrow:'Abastecimiento / Directorio comercial',intro:'Contactos comerciales y proveedores de tu catálogo.',create:'PROVEEDORES_ADMINISTRAR'}) %>
<% const link=(id,extra={})=>'/proveedores?'+new URLSearchParams({buscar:f.buscar||'',offset:String(f.offset||0),...(id?{id:String(id)}:{}),...extra}).toString(); const closeLink=link(selected?.ProveedorId); %>
<%- include('partials/kenneth-search',{actual:'proveedores',label:'proveedores',placeholder:'Nombre comercial o NIT'}) %>
<div class="directory-layout <%= !rows.length&&!selected?'directory-empty-layout':'' %>"><section class="supplier-directory" aria-label="Directorio empresarial"><% if(rows.length){ %><div class="section-heading"><h2>Directorio comercial</h2><%- include('partials/kenneth-state-filter') %></div><% } %>
<% rows.forEach(s=>{ %><a data-record-state="<%= s.Activo?'activo':'inactivo' %>" class="supplier-entry <%= selected?.ProveedorId===s.ProveedorId?'is-selected':'' %>" href="<%= link(s.ProveedorId) %>" <%- selected?.ProveedorId===s.ProveedorId?'aria-current="true"':'' %>><span class="identity-avatar" aria-hidden="true"><%= s.Nombre.slice(0,2).toUpperCase() %></span><div><h2><%= s.Nombre %></h2><p>NIT <%= s.NIT %></p><small><%= s.Correo||s.Telefono||'Sin contacto registrado' %></small></div><span class="master-status <%= s.Activo?'is-active':'is-inactive' %>"><%= s.Activo?'Activo':'Inactivo' %></span></a><% }); %>
<% if(!rows.length){ %><div class="master-empty supplier-first"><span class="identity-avatar" aria-hidden="true"><%- include('partials/icon',{nombre:'users'}) %></span><h2><%= f.buscar||f.offset?'Sin proveedores coincidentes':'Aún no hay proveedores registrados' %></h2><p><%= f.buscar||f.offset?'Prueba otro nombre o NIT, o limpia la búsqueda.':'Registra tu primer proveedor para asociarlo con productos y mantener sus datos comerciales en un solo lugar.' %></p><% if(!f.buscar&&!f.offset&&usuario.permisos.includes('PROVEEDORES_ADMINISTRAR')){ %><a class="btn btn-primary" href="<%= link(null,{nuevo:'1'}) %>"><%- include('partials/icon',{nombre:'plus'}) %> Registrar primer proveedor</a><% } %></div><% } %><p data-state-empty hidden class="master-empty">No hay proveedores con este estado en esta página.</p><% if(rows.length||f.offset){ %><%- include('partials/kenneth-pagination',{label:'proveedores'}) %><% } %></section>
<% if(selected){const s=selected; %><a class="btn btn-outline-secondary record-detail-jump" href="#supplier-detail">Ver proveedor seleccionado</a><aside id="supplier-detail" class="supplier-profile customer-identity"><p class="eyebrow">Ficha comercial</p><div class="identity-heading"><span class="identity-avatar" aria-hidden="true"><%= s.Nombre.slice(0,2).toUpperCase() %></span><div><h2><%= s.Nombre %></h2><span class="master-status <%= s.Activo?'is-active':'is-inactive' %>"><%= s.Activo?'Activo':'Inactivo' %></span></div></div><div class="fiscal-number"><span>NIT</span><strong><%= s.NIT %></strong></div><dl class="master-facts"><dt>Correo</dt><dd><%= s.Correo||'Sin registro' %></dd><dt>Teléfono</dt><dd><%= s.Telefono||'Sin registro' %></dd><dt>Dirección</dt><dd><%= s.Direccion||'Sin registro' %></dd></dl><% if(usuario.permisos.includes('PROVEEDORES_ADMINISTRAR')){ %><a class="btn btn-outline-secondary" href="<%= link(s.ProveedorId,{editar:'1'}) %>">Editar proveedor</a><% } %><% if(usuario.permisos.includes('PRODUCTOS_CONSULTAR')){ %><a class="btn btn-link" href="/productos">Asociar desde Productos</a><% } %><p class="governance-copy">Solo los proveedores activos pueden asociarse al guardar productos. Inactivar conserva las relaciones históricas.</p><h3>Productos suministrados</h3><ul><% relations.forEach(r=>{ %><li><%= r.Codigo %> - <%= r.Descripcion %> (<%= r.Activo?'Activo':'Inactivo' %>)<% if(usuario.permisos.includes('PRODUCTOS_CONSULTAR')){ %> <a href="/productos?id=<%= r.ProductoId %>">Ver producto</a><% } %></li><% }); %></ul></aside><% } %></div>
<% if((f.nuevo||(selected&&f.editar))&&usuario.permisos.includes('PROVEEDORES_ADMINISTRAR')){const s=f.nuevo?{}:selected;const editing=!!s.ProveedorId; %><dialog class="master-drawer" data-auto-open aria-labelledby="supplier-editor-title" data-close-url="<%= closeLink %>"><div class="drawer-heading"><div><p class="eyebrow">Datos comerciales</p><h2 id="supplier-editor-title"><%= editing?'Editar proveedor':'Nuevo proveedor' %></h2></div><a class="btn btn-outline-secondary" href="<%= closeLink %>">Cerrar</a></div><p class="drawer-intro">Completa los datos comerciales y, cuando corresponda, cambia el estado. Los campos con * son obligatorios.</p>
<form method="post" data-master-form data-success="/proveedores?id=" action="/proveedores<%= editing?'/'+s.ProveedorId:'' %>"><input type="hidden" name="Version" value="<%= s.Version||'' %>"><%- include('partials/kenneth-field',{name:'NIT',label:'NIT *',value:s.NIT,max:25}) %><%- include('partials/kenneth-field',{name:'Nombre',label:'Nombre comercial *',value:s.Nombre,max:150}) %><%- include('partials/kenneth-field',{name:'Correo',label:'Correo electrónico',value:s.Correo,max:254,type:'email',required:false}) %><%- include('partials/kenneth-field',{name:'Telefono',label:'Teléfono',value:s.Telefono,max:25,type:'tel',required:false}) %><%- include('partials/kenneth-field',{name:'Direccion',label:'Dirección',value:s.Direccion,max:300,required:false}) %>
<% if(editing){ %><label for="Activo">Estado</label><select name="Activo" id="Activo" class="form-select" data-original-state="<%= s.Activo?'1':'0' %>"><option value="1" <%= s.Activo?'selected':'' %>>Activo</option><option value="0" <%= !s.Activo?'selected':'' %>>Inactivo</option></select><% } %><div class="form-feedback" role="status" aria-live="polite" tabindex="-1" hidden></div><div class="editor-actions"><a class="btn btn-outline-secondary" href="<%= closeLink %>">Cancelar</a><button type="submit" class="btn btn-primary"><%= editing?'Guardar cambios':'Registrar proveedor' %></button></div></form></dialog><% } %>
<%- include('partials/kenneth-confirm') %></main></body></html>
