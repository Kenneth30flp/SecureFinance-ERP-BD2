<link rel="stylesheet" href="/css/navigation.css"><script src="/js/navigation.js" defer></script>
<aside class="sidebar" aria-label="Módulos del sistema">
  <a class="rail-brand" href="/dashboard" aria-label="SecureFinance ERP, inicio"><span aria-hidden="true">SF<span class="brand-dot"></span></span></a>
  <% const navAreas=moduleAreas(usuario); const currentArea=navAreas.find(a=>a.modules.some(m=>m.id===actual)); %>
  <nav class="desk-nav modular-nav" aria-label="Principal">
    <a href="/dashboard" aria-label="Inicio" <%- actual==='dashboard'?'aria-current="page"':'' %>><%- include('icon',{nombre:'dashboard'}) %><span>Inicio</span></a>
    <a href="/modulos" aria-label="Centro de módulos" <%- actual==='modulos'?'aria-current="page"':'' %>><%- include('icon',{nombre:'box'}) %><span>Módulos</span></a>
    <% navAreas.filter(a=>a.id!=='inicio').forEach(area=>{ %><details class="nav-area" <%- currentArea?.id===area.id?'data-active="true"':'' %>><summary aria-label="Área <%= area.name %>"><%- include('icon',{nombre:area.icon}) %><span><%= area.name %></span></summary><div class="nav-panel"><header><strong><%= area.name %></strong><a href="/modulos#area-<%= area.id %>">Ver área ↗</a></header><% if(!area.modules.length){ %><p>No tienes funciones habilitadas en esta área.</p><% } %><% area.modules.forEach(m=>{ %><a href="<%= m.route %>" aria-label="<%= m.name %>" <%- actual===m.id?'aria-current="page"':'' %>><%- include('icon',{nombre:m.icon}) %><span><strong><%= m.name %></strong><small><%= m.description %></small></span></a><% }); %></div></details><% }); %>
  </nav>
  <div class="rail-account"><span class="account-avatar" aria-hidden="true"><%= usuario.nombreUsuario.slice(0,2).toUpperCase() %></span><a class="rail-security" href="/cambiar-password" aria-label="Cambiar contraseña"><%- include('icon',{nombre:'key'}) %></a><a class="rail-security" href="/logout" aria-label="Cerrar sesión"><%- include('icon',{nombre:'logout'}) %></a></div>
</aside>
<header class="workspace-topbar">
  <%- include('brand',{destino:'/dashboard'}) %>
  <div class="topbar-context"><span>Espacio de trabajo</span><strong><%= ({'compras-p3':'Órdenes y abastecimiento',multibodega:'Existencias por ubicacion',creditos:'Cartera y recuperacion',cotizaciones:'Propuestas comerciales',promociones:'Reglas comerciales',devoluciones:'Devoluciones', 'notas-credito':'Notas de crédito', garantias:'Garantías',dashboard:'Panorama financiero',facturacion:'Mesa de transacciones',auditoria:'Control y trazabilidad','auditoria-ddl':'Trazabilidad estructural',usuarios:'Gobierno de accesos',inventario:'Control de existencias',productos:'Catálogo maestro',proveedores:'Relaciones comerciales',clientes:'Identidad fiscal'})[actual] %></strong></div>
  <details class="account-menu"><summary aria-label="Cuenta de <%= usuario.nombreUsuario %>"><span class="account-avatar" aria-hidden="true"><%= usuario.nombreUsuario.slice(0,2).toUpperCase() %></span><span><strong><%= usuario.nombreUsuario %></strong><small><%= rolesCuenta || 'Cuenta de usuario' %></small></span><%- include('icon',{nombre:'chevron'}) %></summary><div class="account-popover"><p>Tu cuenta</p><a href="/dashboard#mis-permisos">Permisos de mi cuenta</a><a href="/cambiar-password"><%- include('icon',{nombre:'key'}) %>Cambiar contraseña</a><a href="/logout"><%- include('icon',{nombre:'logout'}) %>Cerrar sesión</a></div></details>
  <% /* Permission codes remain available outside the business dashboard. */ %>
</header>
