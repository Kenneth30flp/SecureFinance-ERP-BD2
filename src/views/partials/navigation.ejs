<aside class="sidebar" aria-label="Módulos del sistema">
  <a class="rail-brand" href="/dashboard" aria-label="SecureFinance ERP, inicio"><span aria-hidden="true">SF<span class="brand-dot"></span></span></a>
  <nav class="desk-nav" aria-label="Principal">
    <% if (usuario.permisos.includes('ANALITICA_CONSULTAR')) { %><a href="/analitica" <%- actual === 'analitica' ? 'aria-current="page"' : '' %> aria-label="Analítica ejecutiva"><%- include('icon',{nombre:'dashboard'}) %><span>Analítica</span></a><% } %>
    <% [['dashboard','/dashboard','dashboard','Inicio',null],['facturacion','/facturacion','receipt','Facturación','VENTAS_REGISTRAR'],['devoluciones','/devoluciones','receipt','Devoluciones','DEVOLUCIONES_CONSULTAR'],['notas-credito','/notas-credito','receipt','Notas de crédito','DEVOLUCIONES_CONSULTAR'],['garantias','/garantias','shield','Garantías','GARANTIAS_CONSULTAR'],['inventario','/inventario','box','Inventario','INVENTARIO_CONSULTAR'],['productos','/productos','box','Productos','PRODUCTOS_CONSULTAR'],['proveedores','/proveedores','users','Proveedores','PROVEEDORES_CONSULTAR'],['clientes','/clientes','user','Clientes','CLIENTES_CONSULTAR'],['auditoria','/auditoria','shield','Auditoría','AUDITORIA_CONSULTAR'],['usuarios','/usuarios','users','Accesos','USUARIOS_ADMINISTRAR']].forEach(([clave,ruta,icono,label,permiso]) => { if (!permiso || usuario.permisos.includes(permiso)) { %>
      <a class="<%= ['inventario','productos','proveedores','clientes'].includes(clave)?'partii-link':'' %>" href="<%= ruta %>" <%- actual === clave ? 'aria-current="page"' : '' %> aria-label="<%= ({analitica:'Analítica ejecutiva',devoluciones:'Devoluciones', 'notas-credito':'Notas de crédito', garantias:'Garantías',dashboard:'Inicio',facturacion:'Facturación',auditoria:'Auditoría',usuarios:'Usuarios y Roles',inventario:'Inventario',productos:'Productos',proveedores:'Proveedores',clientes:'Clientes'})[clave] %>"><%- include('icon',{nombre:icono}) %><span><%= label %></span></a>
    <% } }); %>
  </nav>
  <div class="rail-account"><span class="account-avatar" aria-hidden="true"><%= usuario.nombreUsuario.slice(0,2).toUpperCase() %></span><a class="rail-security" href="/cambiar-password" aria-label="Cambiar contraseña"><%- include('icon',{nombre:'key'}) %></a><a class="rail-security" href="/logout" aria-label="Cerrar sesión"><%- include('icon',{nombre:'logout'}) %></a></div>
</aside>
<header class="workspace-topbar">
  <%- include('brand',{destino:'/dashboard'}) %>
  <div class="topbar-context"><span>Espacio de trabajo</span><strong><%= ({devoluciones:'Devoluciones', 'notas-credito':'Notas de crédito', garantias:'Garantías',dashboard:'Panorama financiero',facturacion:'Mesa de transacciones',auditoria:'Control y trazabilidad',usuarios:'Gobierno de accesos',inventario:'Control de existencias',productos:'Catálogo maestro',proveedores:'Relaciones comerciales',clientes:'Identidad fiscal'})[actual] %></strong></div>
  <details class="account-menu"><summary aria-label="Cuenta de <%= usuario.nombreUsuario %>"><span class="account-avatar" aria-hidden="true"><%= usuario.nombreUsuario.slice(0,2).toUpperCase() %></span><span><strong><%= usuario.nombreUsuario %></strong><small><%= rolesCuenta || 'Cuenta de usuario' %></small></span><%- include('icon',{nombre:'chevron'}) %></summary><div class="account-popover"><p>Tu cuenta</p><a href="/dashboard#mis-permisos">Permisos de mi cuenta</a><a href="/cambiar-password"><%- include('icon',{nombre:'key'}) %>Cambiar contraseña</a><a href="/logout"><%- include('icon',{nombre:'logout'}) %>Cerrar sesión</a></div></details>
  <% /* Permission codes remain available outside the business dashboard. */ %>
</header>
