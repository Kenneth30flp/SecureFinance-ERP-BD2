<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrf %>"><title><%= title %> | SecureFinance ERP</title><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/kenneth.css"><script src="/js/visual.js" defer></script><script src="/js/kenneth.js" defer></script></head>
<body class="app-shell kenneth-workspace <%= actual %>-workspace"><a class="skip-link" href="#workspace">Ir al contenido</a><%- include('navigation',{actual,rolesCuenta:''}) %><main id="workspace" tabindex="-1" class="container page-content">
<header class="master-heading"><div><p class="eyebrow"><%= eyebrow %></p><h1><%= title %></h1><p class="master-intro"><%= intro %></p></div><% if(typeof create !== 'undefined' && create && usuario.permisos.includes(create)){ %><a class="btn btn-primary" href="/<%= actual %>?<%= new URLSearchParams({buscar:f.buscar||'',nuevo:'1',...(f.vista?{vista:f.vista}:{})}).toString() %>"><%- include('icon',{nombre:'plus'}) %> Nuevo <%= actual==='productos'?'producto':actual==='clientes'?'cliente':'proveedor' %></a><% } %></header>
<div id="module-message" role="status" aria-live="polite" tabindex="-1" hidden></div><noscript><p class="alert alert-warning">La consulta y los filtros funcionan sin JavaScript. Actívalo para guardar cambios y cargar fotografías.</p></noscript>
