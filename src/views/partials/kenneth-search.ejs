<form method="get" class="master-search" role="search"><label for="master-search">Buscar <%= label %></label><div class="search-control"><%- include('icon',{nombre:'search'}) %><input type="search" id="master-search" name="buscar" maxlength="150" class="form-control search-field" placeholder="<%= placeholder %>" value="<%= f.buscar %>"></div><% if(actual==='productos'){ %><input type="hidden" name="vista" value="<%= f.vista||'galeria' %>"><% } %><button class="btn btn-outline-secondary">Buscar</button><a class="btn btn-link" href="/<%= actual %>">Limpiar</a></form>
