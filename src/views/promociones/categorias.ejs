<%- include('head',{title:'Categorías comerciales',subtitle:'Extensión del catálogo para promociones por categoría: una categoría por producto, sin alterar productos.',tab:'categorias'}) %>
<% const editar=usuario.permisos.includes('PROMOCIONES_MODIFICAR'); %>
<div class="cot-layout pro-categories"><section class="cot-register"><header class="cot-register-heading"><div><h2>Categorías</h2><p><%= categorias.length %> registrada(s)</p></div></header>
<% if(categorias.length){ %><div class="cot-ledger-scroll"><table class="cot-ledger cot-history"><caption class="visually-hidden">Categorías comerciales y cantidad de productos asignados.</caption><thead><tr><th>Categoría</th><th>Productos</th><th>Estado</th></tr></thead><tbody><% categorias.forEach(c=>{ %><tr><th scope="row"><strong><%= c.Nombre %></strong></th><td data-label="Productos"><%= c.Productos %></td><td><span class="cot-state pro-state-<%= c.Activa?'VIGENTE':'INACTIVA' %>"><span aria-hidden="true"></span><%= c.Activa?'ACTIVA':'INACTIVA' %></span></td></tr><% }); %></tbody></table></div><% }else{ %><div class="cot-empty"><h3>Sin categorías</h3><p>Crea la primera categoría para usar promociones por categoría.</p></div><% } %></section>
<aside><% if(editar){ %><form class="cot-section" id="pro-category-form" data-operation="<%= operacionId %>"><div class="cot-section-title"><span>+</span><div><h2>Nueva categoría</h2><p>Registro auditado.</p></div></div><label class="form-label" for="pro-category-name">Nombre</label><input class="form-control" id="pro-category-name" maxlength="80" required><label class="form-label mt-3" for="pro-category-reason">Motivo</label><input class="form-control" id="pro-category-reason" maxlength="250" required><button class="btn btn-primary w-100 mt-3">Crear categoría</button></form>
<form class="cot-section" id="pro-assign-form" data-operation="<%= asignacionId %>"><div class="cot-section-title"><span>↔</span><div><h2>Asignar producto</h2><p>Las facturas ya emitidas conservan su promoción aplicada.</p></div></div>
<div class="cot-picker" id="pro-assign-picker"><label class="form-label" for="pro-assign-search">Producto</label><div class="cot-search-input"><%- include('../partials/icon',{nombre:'search'}) %><input class="form-control" id="pro-assign-search" type="search" autocomplete="off" maxlength="150" placeholder="SKU o descripción" aria-controls="pro-assign-results" aria-expanded="false"></div><div class="cot-picker-panel" id="pro-assign-panel" hidden><p class="cot-picker-status" id="pro-assign-status" role="status"></p><div class="cot-results" id="pro-assign-results" role="listbox" aria-label="Productos encontrados"></div></div></div>
<p class="cot-selected" id="pro-assign-selected" hidden></p>
<label class="form-label mt-3" for="pro-assign-category">Categoría</label><select class="form-select" id="pro-assign-category"><option value="">Sin categoría (retirar)</option><% categorias.filter(c=>c.Activa).forEach(c=>{ %><option value="<%= c.CategoriaId %>"><%= c.Nombre %></option><% }); %></select>
<label class="form-label mt-3" for="pro-assign-reason">Motivo</label><input class="form-control" id="pro-assign-reason" maxlength="250" required><button class="btn btn-primary w-100 mt-3">Guardar asignación</button></form>
<% }else{ %><p class="cot-notice">Tu cuenta puede consultar categorías, pero no modificarlas.</p><% } %></aside></div>
</main></body></html>
