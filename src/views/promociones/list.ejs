<%- include('head',{title:'Promociones',subtitle:'Consulta reglas, su vigencia en Guatemala y el estado con el que participan en la facturación.',tab:'lista'}) %>
<% const tipoNombre=Object.fromEntries(tipos.map(t=>[t.TipoCodigo,t.Nombre])); %>
<section class="cot-register"><header class="cot-register-heading"><div><h2>Reglas comerciales</h2><p>Solo las promociones VIGENTES participan en ventas · <%= rows.length %> en esta página</p></div><span class="cot-page-number">Página <%= f.pagina %></span></header>
<form method="get" action="/promociones" class="cot-filters pro-filters"><div class="cot-filter-client"><label for="pro-filter-search">Código o nombre</label><input class="form-control" name="buscar" id="pro-filter-search" placeholder="Buscar promoción" maxlength="150" value="<%= f.buscar %>"></div><div><label for="pro-filter-type">Tipo</label><select class="form-select" name="tipo" id="pro-filter-type"><option value="">Todos los tipos</option><% tipos.forEach(t=>{ %><option value="<%= t.TipoCodigo %>" <%= f.tipo===t.TipoCodigo?'selected':'' %>><%= t.Nombre %></option><% }); %></select></div><div><label for="pro-filter-state">Estado</label><select class="form-select" name="estado" id="pro-filter-state"><option value="">Todos los estados</option><% ['VIGENTE','PROGRAMADA','INACTIVA','VENCIDA'].forEach(s=>{ %><option <%= f.estado===s?'selected':'' %>><%= s %></option><% }); %></select></div><div class="cot-filter-actions"><button class="btn btn-outline-primary">Filtrar</button><a href="/promociones" class="cot-text-link">Limpiar</a></div></form>
<% if(rows.length){ %><div class="cot-ledger-scroll"><table class="cot-ledger cot-history pro-history"><caption class="visually-hidden">Promociones registradas, condiciones y vigencia en hora de Guatemala.</caption><thead><tr><th>Promoción</th><th>Tipo y condición</th><th>Vigencia</th><th>Aplicaciones</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><th scope="row"><a class="cot-document-number" href="/promociones/<%= r.PromocionId %>"><%= r.Codigo %></a><small><%= r.Nombre %></small></th><td data-label="Tipo y condición"><strong><%= tipoNombre[r.TipoCodigo]||r.TipoCodigo %></strong><small><%- include('condition',{p:r}) %></small></td><td data-label="Vigencia"><%- include('../partials/operational-date',{value:r.VigenteDesde,dateOnly:true}) %><small><%- include('../partials/commercial-validity',{value:r.VigenteHasta}) %></small></td><td data-label="Aplicaciones"><strong><%= r.Aplicaciones %></strong><small><%= proMoney(r.DescuentoOtorgado) %> otorgados</small></td><td><span class="cot-state pro-state-<%= r.Estado %>"><span aria-hidden="true"></span><%= r.Estado %></span></td><td><a class="cot-view-link" href="/promociones/<%= r.PromocionId %>">Ver regla <span aria-hidden="true">↗</span></a></td></tr><% }); %></tbody></table></div><% }else{ %><div class="cot-empty"><div class="cot-empty-symbol"><%- include('../partials/icon',{nombre:'activity'}) %></div><h3>No hay promociones para esta búsqueda</h3><p>Prueba otros filtros o registra una regla nueva.</p><% if(usuario.permisos.includes('PROMOCIONES_CREAR')){ %><a class="btn btn-outline-primary" href="/promociones/nueva">Crear promoción</a><% } %></div><% } %>
<% const link=p=>'/promociones?'+new URLSearchParams({buscar:f.buscar,tipo:f.tipo,estado:f.estado,pagina:String(p)}); %><nav class="cot-pagination" aria-label="Paginación"><span>Sin acumulación: cada línea recibe un único beneficio · Importes en GTQ</span><div><% if(f.pagina>1){ %><a class="btn btn-outline-secondary btn-sm" href="<%= link(f.pagina-1) %>">← Anterior</a><% } %><span><%= f.pagina %></span><% if(next){ %><a class="btn btn-outline-secondary btn-sm" href="<%= link(f.pagina+1) %>">Siguiente →</a><% } %></div></nav></section></main></body></html>
