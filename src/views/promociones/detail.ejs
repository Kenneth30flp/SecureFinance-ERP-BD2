<% const p=promocion; const acciones={CREAR:'Creación',EDITAR:'Edición',ACTIVAR:'Activación',DESACTIVAR:'Desactivación'}; %>
<%- include('head',{title:p.Codigo,subtitle:p.Nombre,tab:'lista'}) %>
<div class="cot-detail-toolbar cot-no-print"><a class="cot-text-link" href="/promociones">← Volver a reglas</a></div>
<div class="cot-detail-layout"><article class="cot-document"><header class="cot-document-heading"><div><p class="cot-document-brand">SECUREFINANCE <span>ERP</span></p><h2><%= p.Nombre %></h2><p><%= p.Tipo %> · <%= p.Codigo %></p></div><span class="cot-state pro-state-<%= p.Estado %>"><span aria-hidden="true"></span><%= p.Estado %></span></header>
<div class="cot-document-meta"><div><span>CONDICIÓN DE APLICACIÓN</span><strong><%- include('condition',{p}) %></strong><small><%= p.Descripcion||'Sin descripción' %></small></div><div><span>INICIO</span><strong><%- include('../partials/operational-date',{value:p.VigenteDesde}) %></strong><small>Guatemala (UTC−6)</small></div><div><span>FIN</span><strong><%- include('../partials/commercial-validity',{value:p.VigenteHasta}) %></strong><small>Límite exclusivo</small></div></div>
<div class="pro-policy"><h3>Política aplicada en caja</h3><ul><li>Solo participa si está <strong>VIGENTE</strong>: activa y dentro de su vigencia al registrar la factura. Programadas, inactivas y vencidas no se aplican.</li><li>Por línea gana el mayor descuento monetario entre el descuento manual y la mejor promoción; nunca se acumulan.</li><li>Empate entre promociones: mayor importe, mayor beneficio teórico y, por último, la regla más antigua.</li><li>El IVA (12%) se calcula sobre el subtotal neto después del descuento, con redondeo a centavos.</li></ul></div>
<div class="cot-ledger-scroll"><table class="cot-ledger cot-document-lines"><caption class="pro-caption"><%= p.Elegibilidad==='CATEGORIA'?'Categorías elegibles':'Productos elegibles' %></caption><thead><tr><% if(p.Elegibilidad==='CATEGORIA'){ %><th>Categoría</th><th>Productos asignados</th><th>Estado</th><% }else{ %><th>Producto</th><th>Precio actual</th><th>Estado</th><% } %></tr></thead><tbody>
<% if(p.Elegibilidad==='CATEGORIA'){ categorias.forEach(c=>{ %><tr><th scope="row"><strong><%= c.Nombre %></strong></th><td data-label="Productos"><%= c.Productos %></td><td data-label="Estado"><%= c.Activa?'Activa':'Inactiva' %></td></tr><% }); }else{ productos.forEach(x=>{ %><tr><th scope="row"><strong><%= x.Descripcion %></strong><small><%= x.Codigo %></small></th><td data-label="Precio actual" class="cot-money"><%= proMoney(x.Precio) %></td><td data-label="Estado"><%= x.Activo?'Activo':'Inactivo' %></td></tr><% }); } %></tbody></table></div>
<section class="pro-section"><h3>Aplicaciones recientes en facturas</h3><% if(aplicaciones.length){ %><div class="cot-ledger-scroll"><table class="cot-ledger"><caption class="visually-hidden">Últimas 20 líneas facturadas con esta promoción; importes históricos.</caption><thead><tr><th>Factura</th><th>Producto</th><th>Cantidad</th><th>Descuento</th></tr></thead><tbody><% aplicaciones.forEach(a=>{ %><tr><th scope="row"><% if(usuario.permisos.includes('FACTURAS_CONSULTAR')){ %><a class="cot-document-number" href="/facturacion/facturas/<%= a.FacturaId %>">#<%= a.FacturaId %></a><% }else{ %>#<%= a.FacturaId %><% } %><small><%- include('../partials/operational-date',{value:a.FechaHora}) %></small></th><td data-label="Producto"><strong><%= a.Descripcion %></strong><small><%= a.Codigo %></small></td><td data-label="Cantidad"><%= a.Cantidad %><% if(a.UnidadesBonificadas){ %><small><%= a.UnidadesBonificadas %> bonificada(s)</small><% } %></td><td data-label="Descuento" class="cot-money"><%= proMoney(a.DescuentoMonto) %><small><%= a.DescuentoPorcentaje %>%</small></td></tr><% }); %></tbody></table></div><% }else{ %><p class="cot-hint">Esta promoción todavía no se ha aplicado en ventas.</p><% } %></section>
<footer class="cot-document-footer"><span>Creada por <%= p.CreadaPor %> · <%- include('../partials/operational-date',{value:p.FechaCreacion}) %></span><span>Última modificación: <%= p.ModificadaPor %> · <%- include('../partials/operational-date',{value:p.FechaModificacion}) %></span></footer></article>
<aside class="cot-detail-actions cot-no-print"><section class="cot-action-panel"><p class="eyebrow">ADMINISTRACIÓN</p>
<% if(p.Estado==='VENCIDA'){ %><h2>Vigencia finalizada</h2><p>La regla se conserva como historial. Las facturas emitidas mantienen sus importes.</p><% }else{ %>
<h2><%= p.Activa?'Publicada para caja':'No participa en ventas' %></h2><p><%= p.Estado==='PROGRAMADA'?'Activa; se aplicará automáticamente desde su fecha de inicio.':p.Activa?'Se aplica a ventas nuevas mientras siga vigente.':'Actívala para que participe en ventas dentro de su vigencia.' %></p>
<% if(usuario.permisos.includes('PROMOCIONES_ACTIVAR')){ %><form id="pro-state" data-id="<%= p.PromocionId %>" data-version="<%= p.Version %>" data-operation="<%= operacionId %>" data-activa="<%= p.Activa?'false':'true' %>"><label class="form-label" for="pro-state-reason">Motivo</label><textarea class="form-control" id="pro-state-reason" maxlength="250" rows="2" required></textarea><button class="btn <%= p.Activa?'btn-outline-danger':'btn-primary' %> w-100"><%= p.Activa?'Desactivar promoción':'Activar promoción' %></button></form><% } %>
<% if(usuario.permisos.includes('PROMOCIONES_MODIFICAR')){ %><a class="btn btn-outline-primary w-100" href="/promociones/<%= p.PromocionId %>/editar">Editar configuración</a><% } %>
<% if(!usuario.permisos.includes('PROMOCIONES_ACTIVAR') && !usuario.permisos.includes('PROMOCIONES_MODIFICAR')){ %><p class="cot-notice">Tu cuenta puede consultar esta regla, pero no modificarla.</p><% } %><% } %>
<dl class="cot-totals"><div><dt>Líneas facturadas</dt><dd><%= p.Aplicaciones %></dd></div><div><dt>Descuento otorgado</dt><dd><%= proMoney(p.DescuentoOtorgado) %></dd></div></dl></section>
<details class="cot-technical"><summary>Referencia técnica</summary><small>Versión</small><code class="cot-reference"><%= p.Version %></code></details></aside></div>
<section class="cot-timeline pro-history-log"><h2>Historial de cambios</h2><ol><% historial.forEach(h=>{ %><li><span class="cot-timeline-dot"></span><div><strong><%= acciones[h.Accion]||h.Accion %></strong><p><%= h.Motivo %></p><small><%= h.Responsable %> · <%- include('../partials/operational-date',{value:h.FechaHora}) %></small><% if(h.CamposModificados){ %><small class="pro-fields">Campos: <%= h.CamposModificados.split(',').join(', ') %></small><% } %><details class="pro-diff"><summary>Ver valores anterior y nuevo</summary><% if(h.ValorAnterior){ %><p class="pro-diff-label">Anterior</p><pre><%= JSON.stringify(JSON.parse(h.ValorAnterior),null,1) %></pre><% } %><p class="pro-diff-label">Nuevo</p><pre><%= JSON.stringify(JSON.parse(h.ValorNuevo),null,1) %></pre></details></div></li><% }); %></ol></section>
</main></body></html>
