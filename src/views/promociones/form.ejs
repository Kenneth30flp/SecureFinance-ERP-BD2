<% const edit=!!promocion; const p=promocion||{};
const gt=(d,end)=>{ if(!d) return ''; const raw=typeof d==='string'&&!/(?:Z|[+-]\d{2}:\d{2})$/i.test(d)?d+'Z':d; return new Intl.DateTimeFormat('en-CA',{timeZone:'America/Guatemala'}).format(new Date(new Date(raw).getTime()-(end?1:0))); };
const hoy=gt(ahora||new Date()), fin=gt(new Date(new Date(ahora||Date.now()).getTime()+30*86400000));
const aplicada=edit && p.Aplicaciones>0; const cats=typeof categoriasSeleccion!=='undefined'?categoriasSeleccion:[]; %>
<%- include('head',{title:edit?'Editar '+p.Codigo:'Nueva promoción',subtitle:edit?'Los cambios quedan en el historial con el valor anterior, el nuevo, el responsable y el motivo.':'Las reglas se crean INACTIVAS; un responsable con permiso de activación las publica.',tab:edit?'lista':'nueva'}) %>
<form id="pro-form" class="cot-layout" novalidate data-mode="<%= edit?'edit':'create' %>" data-id="<%= p.PromocionId||'' %>" data-version="<%= p.Version||'' %>" data-operation="<%= operacionId %>">
<div class="cot-editor">
<section class="cot-section"><div class="cot-section-title"><span>01</span><div><h2>Identificación</h2><p>Código único e inmutable, nombre visible para caja.</p></div></div>
<div class="pro-grid"><div><label class="form-label" for="pro-code">Código <span class="cot-required">*</span></label><input class="form-control" id="pro-code" name="Codigo" maxlength="30" pattern="[A-Za-z0-9_\-]{1,30}" required value="<%= p.Codigo||'' %>" <%= edit?'readonly':'' %> placeholder="VERANO-10"><p class="cot-hint">Letras, números y guion. No cambia después de crearse.</p></div>
<div class="pro-span-2"><label class="form-label" for="pro-name">Nombre <span class="cot-required">*</span></label><input class="form-control" id="pro-name" name="Nombre" maxlength="120" required value="<%= p.Nombre||'' %>" placeholder="10% en accesorios de oficina"></div>
<div class="pro-span-3"><label class="form-label" for="pro-description">Descripción · opcional</label><input class="form-control" id="pro-description" name="Descripcion" maxlength="250" value="<%= p.Descripcion||'' %>"></div></div></section>
<section class="cot-section"><div class="cot-section-title"><span>02</span><div><h2>Tipo y condiciones</h2><p>Una sola regla por línea: la venta elige el mayor beneficio válido, sin sumar descuentos.</p></div></div>
<% if(aplicada){ %><p class="cot-notice">Esta promoción ya se aplicó en <%= p.Aplicaciones %> línea(s) facturada(s). Solo puedes cambiar el nombre, la descripción o adelantar la fecha final; para otras condiciones crea una regla nueva.</p><% } %>
<fieldset class="pro-types" <%= aplicada?'disabled':'' %>><legend class="form-label">Tipo de promoción <span class="cot-required">*</span></legend><% tipos.forEach((t,i)=>{ %><label class="pro-type"><input type="radio" name="TipoCodigo" value="<%= t.TipoCodigo %>" data-eligibility="<%= t.Elegibilidad %>" <%= (p.TipoCodigo||'PORCENTAJE')===t.TipoCodigo?'checked':'' %>><span><strong><%= t.Nombre %></strong><small><%= t.Descripcion %></small></span></label><% }); %></fieldset>
<div class="pro-grid pro-conditions"><div data-field="porcentaje"><label class="form-label" for="pro-percent">Porcentaje <span class="cot-required">*</span></label><div class="pro-suffix"><input class="form-control" id="pro-percent" name="Porcentaje" type="number" min="0.01" max="90" step="0.01" value="<%= p.Porcentaje||'' %>" <%= aplicada?'readonly':'' %>><span>%</span></div><p class="cot-hint">Entre 0.01 y 90.00.</p></div>
<div data-field="minima"><label class="form-label" for="pro-minimum">Cantidad mínima por línea</label><input class="form-control" id="pro-minimum" name="CantidadMinima" type="number" min="1" max="100000" step="1" value="<%= p.CantidadMinima||'' %>" <%= aplicada?'readonly':'' %>><p class="cot-hint" id="pro-minimum-hint">Opcional. En volumen es obligatoria (2 o más).</p></div>
<div data-field="tope"><label class="form-label" for="pro-cap">Tope por línea · opcional</label><div class="pro-suffix pro-prefix"><span>Q</span><input class="form-control" id="pro-cap" name="TopeDescuento" type="number" min="0.01" step="0.01" value="<%= p.TopeDescuento||'' %>" <%= aplicada?'readonly':'' %>></div></div></div>
<p class="cot-hint pro-twoforone" hidden>2x1: por cada dos unidades del mismo producto en una línea se bonifica una (unidades bonificadas = parte entera de cantidad ÷ 2; importe = unidades × precio). El importe registrado nunca supera ese beneficio.</p></section>
<section class="cot-section"><div class="cot-section-title"><span>03</span><div><h2>Vigencia</h2><p>Días de Guatemala. Inicio a las 00:00 y fin inclusivo hasta las 23:59:59.</p></div></div>
<div class="pro-grid"><div><label class="form-label" for="pro-from">Fecha de inicio <span class="cot-required">*</span></label><input class="form-control" type="date" id="pro-from" name="Desde" required value="<%= edit?gt(p.VigenteDesde):hoy %>" <%= aplicada?'readonly':'' %>></div><div><label class="form-label" for="pro-to">Fecha de fin <span class="cot-required">*</span></label><input class="form-control" type="date" id="pro-to" name="Hasta" required value="<%= edit?gt(p.VigenteHasta,true):fin %>" <%= aplicada?'max="'+gt(p.VigenteHasta,true)+'"':'' %>><p class="cot-hint">Máximo un año. Las promociones vencidas no se editan.</p></div></div></section>
<section class="cot-section" data-eligibility="PRODUCTO"><div class="cot-section-title"><span>04</span><div><h2>Productos elegibles</h2><p>Los productos no seleccionados no reciben esta promoción.</p></div></div>
<% if(!aplicada){ %><div class="cot-picker" id="pro-product-picker"><label class="form-label" for="pro-product-search">Buscar producto por SKU o descripción</label><div class="cot-search-input"><%- include('../partials/icon',{nombre:'search'}) %><input class="form-control" id="pro-product-search" type="search" autocomplete="off" maxlength="150" placeholder="Escribe al menos 2 caracteres" aria-controls="pro-product-results" aria-expanded="false"></div><div class="cot-picker-panel" id="pro-product-panel" hidden><p class="cot-picker-status" id="pro-product-status" role="status"></p><div class="cot-results" id="pro-product-results" role="listbox" aria-label="Productos encontrados"></div></div></div><% } %>
<ul class="pro-chips" id="pro-products" aria-label="Productos seleccionados"><% seleccion.forEach(s=>{ %><li data-id="<%= s.ProductoId %>"><span><strong><%= s.Codigo %></strong> <%= s.Descripcion %></span><% if(!aplicada){ %><button type="button" class="pro-chip-remove" aria-label="Quitar <%= s.Descripcion %>">×</button><% } %></li><% }); %></ul><p class="cot-hint" id="pro-products-empty" <%= seleccion.length?'hidden':'' %>>Aún no hay productos seleccionados.</p></section>
<section class="cot-section" data-eligibility="CATEGORIA" hidden><div class="cot-section-title"><span>04</span><div><h2>Categorías elegibles</h2><p>Aplica a productos asignados a la categoría al momento de facturar.</p></div></div>
<% if(!categorias.length){ %><p class="cot-notice">No hay categorías comerciales. <a class="cot-text-link" href="/promociones/categorias">Crea una categoría</a> y asigna productos.</p><% } %><fieldset class="pro-category-list" <%= aplicada?'disabled':'' %>><legend class="visually-hidden">Categorías</legend><% categorias.filter(c=>c.Activa).forEach(c=>{ %><label class="pro-check"><input type="checkbox" name="Categorias" value="<%= c.CategoriaId %>" <%= cats.some(x=>x.CategoriaId===c.CategoriaId)?'checked':'' %>><span><%= c.Nombre %> <small><%= c.Productos %> producto(s)</small></span></label><% }); %></fieldset></section>
</div>
<aside class="cot-summary"><div class="cot-summary-heading"><span class="cot-section-index"><%- include('../partials/icon',{nombre:'shield'}) %></span><h2>Confirmación</h2><span><%= edit?p.Estado:'INACTIVA' %></span></div>
<label class="form-label" for="pro-reason">Motivo del <%= edit?'cambio':'alta' %> <span class="cot-required">*</span></label><textarea class="form-control" id="pro-reason" name="Motivo" maxlength="250" rows="3" required placeholder="Ej. Campaña autorizada por gerencia comercial"></textarea>
<p class="cot-summary-note">Se registran tu usuario, la fecha UTC, el valor anterior y el nuevo. <%= edit?'':'La promoción se crea inactiva.' %></p>
<button class="btn btn-primary w-100" id="pro-submit"><%= edit?'Guardar cambios':'Crear promoción' %></button>
<% if(edit){ %><a class="cot-text-link cot-refresh" href="/promociones/<%= p.PromocionId %>">Cancelar y volver</a><% } %>
<details class="cot-technical"><summary>Referencia técnica</summary><small>Operación</small><code class="cot-reference"><%= operacionId %></code><% if(edit){ %><small>Versión</small><code class="cot-reference"><%= p.Version %></code><% } %></details></aside>
</form></main></body></html>
