<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrf %>">
<title><%= title %> | SecureFinance ERP</title><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/cotizaciones.css"><link rel="stylesheet" href="/css/promociones.css"><script src="/js/visual.js" defer></script><script src="/js/operationalDates.js" defer></script><script src="/js/promociones.js" defer></script></head>
<body class="app-shell cot-app pro-app"><a class="skip-link" href="#workspace">Ir al contenido</a><%- include('../partials/navigation',{actual:'promociones',rolesCuenta:''}) %>
<main class="container page-content cot-workspace pro-workspace" id="workspace" tabindex="-1">
<header class="cot-page-heading"><div><p class="eyebrow">GESTIÓN COMERCIAL <span aria-hidden="true">/</span> PROMOCIONES</p><h1><%= title %></h1><p><%= typeof subtitle!=='undefined'?subtitle:'Reglas comerciales autorizadas, vigencias y trazabilidad de cada descuento.' %></p></div></header>
<nav class="cot-tabs cot-no-print" aria-label="Promociones"><a href="/promociones" <%- tab==='lista'?'aria-current="page"':'' %>>Reglas promocionales</a><% if(usuario.permisos.includes('PROMOCIONES_CREAR')){ %><a href="/promociones/nueva" <%- tab==='nueva'?'aria-current="page"':'' %>><span aria-hidden="true">+</span> Nueva promoción</a><% } %><a href="/promociones/categorias" <%- tab==='categorias'?'aria-current="page"':'' %>>Categorías comerciales</a></nav>
<div id="pro-message" class="cot-notice cot-notice-error" role="alert" tabindex="-1" hidden></div>
