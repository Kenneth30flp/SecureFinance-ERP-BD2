<%- include('head',{title:documento.Numero}) %>
<section class="work-panel cot-document"><div class="panel-body"><div class="cot-document-heading"><div><p class="eyebrow">Cotización / Comprobante interno</p><h2><%= documento.Numero %></h2><p>No es factura tributaria ni comprobante de pago.</p></div><span class="status-badge cot-state-<%= documento.Estado %>"><%= documento.Estado %></span></div>
<div class="cot-filters"><div><small>Cliente</small><p><strong><%= documento.ClienteNombre %></strong><br>NIT <%= documento.ClienteNIT %></p></div><div><small>Emisión · Guatemala</small><p><%- include('../partials/operational-date',{value:documento.FechaCreacion}) %></p></div><div><small>Vencimiento · límite exclusivo</small><p><%- include('../partials/operational-date',{value:documento.VenceEn}) %></p></div><div><small>Responsable</small><p><%= documento.Responsable %></p></div></div>
<div class="table-responsive" tabindex="0" role="region" aria-label="Detalle histórico"><table class="table table-modern"><caption>Precios y descripciones capturados al emitir. GTQ.</caption><thead><tr><th>SKU / Producto</th><th>Cantidad</th><th>Precio Q</th><th>Descuento %</th><th>Descuento Q</th><th>Neto Q</th></tr></thead><tbody><% lineas.forEach(l=>{ %><tr><th scope="row"><%= l.SKU %><br><small><%= l.Descripcion %></small></th><td><%= l.Cantidad %></td><td><%= l.PrecioUnitario %></td><td><%= l.DescuentoPorcentaje %></td><td><%= l.DescuentoMonto %></td><td><%= l.SubtotalNeto %></td></tr><% }); %></tbody></table></div>
<dl class="cot-totals cot-document-totals"><% [['Subtotal',documento.Subtotal],['Descuento',documento.Descuento],['Neto',documento.SubtotalNeto],['IVA 12%',documento.IVA],['Total',documento.Total]].forEach(([label,value])=>{ %><div><dt><%= label %></dt><dd>Q <%= value %></dd></div><% }); %></dl><% if(documento.Observaciones){ %><p class="cot-notes"><strong>Observaciones:</strong> <%= documento.Observaciones %></p><% } %>
<% if(documento.FacturaId){ %><p>Factura vinculada: <% if(usuario.permisos.includes('FACTURAS_CONSULTAR')){ %><a href="/facturacion/facturas/<%= documento.FacturaId %>">#<%= documento.FacturaId %></a><% }else{ %>#<%= documento.FacturaId %><% } %></p><% } %><p class="summary-note">Referencia de emisión: <%= documento.OperacionId %></p><button class="btn btn-outline-secondary cot-no-print" type="button" id="cot-print">Imprimir comprobante</button></div></section>
<% if(documento.Estado==='PROCESADA'){ %><p class="alert alert-success cot-no-print" role="status">Cotización convertida correctamente a factura de contado #<%= documento.FacturaId %>. El cobro y la salida de inventario están registrados; no se permite otra conversión.</p><% } %>
<% if(documento.Estado==='ACTIVA'){ %>
<% if(conversion.installed && conversion.executable && conversion.allowed && usuario.permisos.includes('COTIZACIONES_CONVERTIR') && usuario.permisos.includes('VENTAS_REGISTRAR')){ %>
<section class="work-panel cot-no-print"><div class="panel-body"><h2 class="h5">Convertir a factura de contado</h2><p>Se respetan los precios y descuentos pactados. La disponibilidad se confirma al procesar; se registran caja, existencias y Kardex conjuntamente.</p><form id="cot-convert" data-id="<%= documento.CotizacionId %>" data-operation="<%= conversionOperacion %>"><button class="btn btn-primary">Convertir a factura</button><a class="btn btn-outline-secondary" href="/cotizaciones/<%= documento.CotizacionId %>">Consultar estado actual</a></form><p class="summary-note cot-reference">Referencia de conversión: <%= conversionOperacion %></p></div></section>
<% }else if(!conversion.installed || !conversion.executable){ %><p class="alert alert-info cot-no-print">La conversión no está disponible en esta instancia. Solicita al responsable verificar la instalación y permisos SQL del módulo.</p><% }else{ %><p class="alert alert-info cot-no-print">Tu cuenta no está autorizada para convertir este documento.</p><% } %>
<% if(usuario.permisos.includes('COTIZACIONES_CANCELAR')){ %><section class="work-panel cot-no-print"><div class="panel-body"><h2 class="h5">Cancelar cotización</h2><form id="cot-cancel" data-id="<%= documento.CotizacionId %>" data-operation="<%= operacionId %>"><label for="cot-reason">Motivo</label><input id="cot-reason" class="form-control" maxlength="250" required><button class="btn btn-outline-danger mt-3">Cancelar cotización</button></form></div></section><% } %><% } %>
<% if(documento.Estado==='VENCIDA'){ %><p class="alert alert-warning cot-no-print">La vigencia terminó. No puede convertirse; emite una nueva cotización para acordar condiciones actuales.</p><% } %>
<section class="work-panel"><div class="panel-body"><h2 class="h5">Historial de estados</h2><ul><% historial.forEach(h=>{ %><li><strong><%= h.EstadoNuevo %></strong> · <%- include('../partials/operational-date',{value:h.FechaHora}) %> · <%= h.Responsable %> · <%= h.Motivo %></li><% }); %></ul><% if(documento.Estado==='VENCIDA'){ %><p>VENCIDA es una condición temporal calculada por la TVF con el reloj SQL. La consulta no modifica el documento.</p><% } %></div></section></main></body></html>
