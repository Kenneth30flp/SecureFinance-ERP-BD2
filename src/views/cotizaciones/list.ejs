<%- include('head',{title:'Cotizaciones'}) %>
<section class="work-panel"><div class="panel-body"><h2 class="h5">Buscar documentos</h2><form method="get" action="/cotizaciones" class="cot-filters">
<label>Número<input class="form-control" name="numero" placeholder="COT-1" maxlength="14" value="<%= f.numero %>"></label>
<label>Cliente o NIT<input class="form-control" name="cliente" maxlength="150" value="<%= f.cliente %>"></label>
<label>Estado<select class="form-select" name="estado"><option value="">Todos</option><% ['ACTIVA','VENCIDA','PROCESADA','CANCELADA'].forEach(s=>{ %><option <%= f.estado===s?'selected':'' %>><%= s %></option><% }); %></select></label>
<label>Desde<input class="form-control" type="date" name="desde" value="<%= f.desde %>"></label><label>Hasta<input class="form-control" type="date" name="hasta" value="<%= f.hasta %>"></label>
<div class="cot-actions"><button class="btn btn-primary">Buscar</button><a href="/cotizaciones" class="btn btn-outline-secondary">Limpiar</a></div></form></div></section>
<section class="work-panel"><div class="panel-body"><h2 class="h5">Documentos emitidos</h2><% if(rows.length){ %><div class="table-responsive" role="region" aria-label="Historial de cotizaciones" tabindex="0"><table class="table table-modern"><caption>Importes históricos en quetzales. Una cotización no es factura tributaria.</caption><thead><tr><th>Número</th><th>Cliente</th><th>Emisión</th><th>Vencimiento</th><th>Responsable</th><th>Total Q</th><th>Estado</th><th>Documento</th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><th scope="row"><%= r.Numero %></th><td><strong><%= r.ClienteNombre %></strong><br><small><%= r.ClienteNIT %></small></td><td><%- include('../partials/operational-date',{value:r.FechaCreacion}) %></td><td><%- include('../partials/operational-date',{value:r.VenceEn}) %></td><td><%= r.Responsable %></td><td><%= r.Total %></td><td><span class="status-badge cot-state-<%= r.Estado %>"><%= r.Estado %></span></td><td><a href="/cotizaciones/<%= r.CotizacionId %>">Ver detalle</a></td></tr><% }); %>
</tbody></table></div><% }else{ %><div class="empty-state"><h3>No hay cotizaciones para esta búsqueda</h3><p>Revisa los filtros o emite una propuesta nueva.</p></div><% } %>
<% const link=p=>'/cotizaciones?'+new URLSearchParams({numero:f.numero,cliente:f.cliente,estado:f.estado,desde:f.desde,hasta:f.hasta,pagina:String(p)}); %><nav class="cot-actions" aria-label="Paginación"><% if(f.pagina>1){ %><a class="btn btn-outline-secondary" href="<%= link(f.pagina-1) %>">Anterior</a><% } %><span>Página <%= f.pagina %></span><% if(next){ %><a class="btn btn-outline-secondary" href="<%= link(f.pagina+1) %>">Siguiente</a><% } %></nav>
</div></section></main></body></html>
