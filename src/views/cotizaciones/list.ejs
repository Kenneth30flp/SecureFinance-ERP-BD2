<%- include('head',{title:'Cotizaciones',subtitle:'Consulta propuestas, revisa su vigencia y continúa con la facturación.'}) %>
<section class="cot-register"><header class="cot-register-heading"><div><h2>Propuestas comerciales</h2><p>Documentos emitidos · <%= rows.length %> en esta página</p></div><span class="cot-page-number">Página <%= f.pagina %></span></header>
<form method="get" action="/cotizaciones" class="cot-filters"><div><label for="cot-filter-number">Número</label><input class="form-control" name="numero" id="cot-filter-number" placeholder="COT-1" maxlength="14" value="<%= f.numero %>"></div><div class="cot-filter-client"><label for="cot-filter-client">Cliente o NIT</label><input class="form-control" name="cliente" id="cot-filter-client" placeholder="Buscar cliente" maxlength="150" value="<%= f.cliente %>"></div><div><label for="cot-filter-state">Estado</label><select class="form-select" name="estado" id="cot-filter-state"><option value="">Todos los estados</option><% ['ACTIVA','VENCIDA','PROCESADA','CANCELADA'].forEach(s=>{ %><option <%= f.estado===s?'selected':'' %>><%= s %></option><% }); %></select></div><div><label for="cot-filter-from">Desde</label><input class="form-control" type="date" name="desde" id="cot-filter-from" value="<%= f.desde %>"></div><div><label for="cot-filter-to">Hasta</label><input class="form-control" type="date" name="hasta" id="cot-filter-to" value="<%= f.hasta %>"></div><div class="cot-filter-actions"><button class="btn btn-outline-primary">Filtrar</button><a href="/cotizaciones" class="cot-text-link">Limpiar</a></div></form>
<% if(rows.length){ %><div class="cot-ledger-scroll"><table class="cot-ledger cot-history"><caption class="visually-hidden">Cotizaciones emitidas, importes en quetzales y fechas de Guatemala.</caption><thead><tr><th>Cotización</th><th>Cliente</th><th>Emisión / vigencia</th><th>Total</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><th scope="row"><a class="cot-document-number" href="/cotizaciones/<%= r.CotizacionId %>"><%= r.Numero %></a><small><%= r.Responsable %></small></th><td><strong><%= r.ClienteNombre %></strong><small><%= typeof laboratorio!=='undefined' && laboratorio.demo && /^DEMOCOT\d+$/.test(r.ClienteNIT)?'Identificador de demostración:':'NIT' %> <%= r.ClienteNIT %></small></td><td><%- include('../partials/operational-date',{value:r.FechaCreacion}) %><small><%- include('../partials/commercial-validity',{value:r.VenceEn}) %></small></td><td class="cot-money"><%= cotMoney(r.Total) %></td><td><span class="cot-state cot-state-<%= r.Estado %>"><span aria-hidden="true"></span><%= r.Estado %></span></td><td><a class="cot-view-link" href="/cotizaciones/<%= r.CotizacionId %>">Ver cotización <span aria-hidden="true">↗</span></a></td></tr><% }); %></tbody></table></div><% }else{ %><div class="cot-empty"><div class="cot-empty-symbol"><%- include('../partials/icon',{nombre:'receipt'}) %></div><h3>No hay cotizaciones para esta búsqueda</h3><p>Prueba otros filtros o prepara una propuesta nueva.</p><% if(usuario.permisos.includes('COTIZACIONES_CREAR')){ %><a class="btn btn-outline-primary" href="/cotizaciones/nueva">Crear cotización</a><% } %></div><% } %>
<% const link=p=>'/cotizaciones?'+new URLSearchParams({numero:f.numero,cliente:f.cliente,estado:f.estado,desde:f.desde,hasta:f.hasta,pagina:String(p)}); %><nav class="cot-pagination" aria-label="Paginación"><span>Precios históricos · Importes en GTQ</span><div><% if(f.pagina>1){ %><a class="btn btn-outline-secondary btn-sm" href="<%= link(f.pagina-1) %>">← Anterior</a><% } %><span><%= f.pagina %></span><% if(next){ %><a class="btn btn-outline-secondary btn-sm" href="<%= link(f.pagina+1) %>">Siguiente →</a><% } %></div></nav></section></main></body></html>
