<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrf %>">
<title><%= title %> | SecureFinance ERP</title><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/cotizaciones.css"><script src="/js/visual.js" defer></script><script src="/js/operationalDates.js" defer></script><script src="/js/cotizaciones.js" defer></script></head>
<body class="app-shell cot-app" data-demo="<%= typeof laboratorio!=='undefined' && laboratorio.demo?'true':'false' %>"><a class="skip-link" href="#workspace">Ir al contenido</a><%- include('../partials/navigation',{actual:'cotizaciones',rolesCuenta:''}) %>
<main class="container page-content cot-workspace" id="workspace" tabindex="-1">
<header class="cot-page-heading"><div><p class="eyebrow">GESTIÓN COMERCIAL <span aria-hidden="true">/</span> COTIZACIONES</p><h1><%= title %></h1><p><%= typeof subtitle!=='undefined'?subtitle:'Propuestas claras, precios acordados y continuidad hasta la factura.' %></p></div>
<% if(typeof laboratorio!=='undefined'){ %><details class="cot-environment cot-no-print"><summary><span class="cot-dot"></span><%= laboratorio.demo?'Demostración':'Laboratorio de pruebas' %></summary><small>Puerto <%= laboratorio.port %> · <%= laboratorio.database %></small></details><% } %></header>
<nav class="cot-tabs cot-no-print" aria-label="Cotizaciones"><% if(usuario.permisos.includes('COTIZACIONES_CONSULTAR')){ %><a href="/cotizaciones" <%- title==='Cotizaciones'?'aria-current="page"':'' %>>Historial de cotizaciones</a><% } %><% if(usuario.permisos.includes('COTIZACIONES_CREAR')){ %><a href="/cotizaciones/nueva" <%- title==='Nueva cotización'?'aria-current="page"':'' %>><span aria-hidden="true">+</span> Nueva cotización</a><% } %></nav>
<div id="cot-message" class="cot-notice cot-notice-error" role="alert" tabindex="-1" hidden></div>
