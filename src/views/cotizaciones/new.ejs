<%- include('head',{title:'Nueva cotización',subtitle:'Prepara una propuesta comercial. Las existencias se confirman al convertirla.'}) %>
<noscript><p class="cot-notice">Activa JavaScript para buscar clientes y preparar la cotización.</p></noscript>
<form id="cot-create" data-operation="<%= operacionId %>" data-max-discount="<%= politica.MaxDescuento %>">
<div class="cot-layout"><div class="cot-editor">
<section class="cot-section" aria-labelledby="cot-general-title"><div class="cot-section-title"><span>01</span><div><h2 id="cot-general-title">Información general</h2><p>Identifica al cliente y define la vigencia de la propuesta.</p></div></div>
<div class="cot-general-grid"><div class="cot-client-field"><label class="form-label" for="cot-client-search">Cliente <span class="cot-required">*</span></label>
<div class="cot-picker" data-picker="clientes"><div class="cot-search-input"><%- include('../partials/icon',{nombre:'search'}) %><input id="cot-client-search" class="form-control" type="search" maxlength="150" placeholder="Buscar por nombre o NIT" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="cot-client-results" aria-describedby="cot-client-help"></div><input id="cot-client" type="hidden"><div class="cot-picker-panel" hidden><div id="cot-client-results" class="cot-results" role="listbox" aria-label="Clientes disponibles"></div><div class="cot-picker-pages"></div><p class="cot-picker-status" role="status" aria-live="polite"></p></div></div>
<p id="cot-client-help" class="cot-hint">Busca y selecciona un cliente activo.</p><div id="cot-client-selected" class="cot-selected" hidden></div></div>
<div><span class="form-label">Fecha de emisión</span><div class="cot-readonly"><strong><%- include('../partials/operational-date',{value:politica.Ahora}) %></strong><small>Guatemala · UTC−6</small></div></div>
<div><label class="form-label" for="cot-expiry">Válida hasta <span class="cot-required">*</span></label><input id="cot-expiry" type="date" class="form-control" required aria-describedby="cot-expiry-help"><p id="cot-expiry-help" class="cot-hint">Incluye el día seleccionado · máximo 90 días.</p></div></div>
<details class="cot-notes-field"><summary>Agregar observaciones <span>Opcional</span></summary><label class="visually-hidden" for="cot-notes">Observaciones</label><textarea id="cot-notes" maxlength="1000" class="form-control" rows="2" placeholder="Condiciones o información relevante para el cliente"></textarea></details></section>
<section class="cot-section" aria-labelledby="cot-products-title"><div class="cot-section-title"><span>02</span><div><h2 id="cot-products-title">Productos</h2><p>Agrega productos y ajusta sus cantidades o descuentos en la tabla.</p></div></div>
<div class="cot-product-entry"><div class="cot-product-field"><label class="form-label" for="cot-search">Buscar producto</label><div class="cot-picker" data-picker="productos"><div class="cot-search-input"><%- include('../partials/icon',{nombre:'search'}) %><input id="cot-search" type="search" class="form-control" maxlength="150" placeholder="Buscar por SKU o descripción" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="cot-product-results"></div><input type="hidden" id="cot-product"><div class="cot-picker-panel" hidden><div id="cot-product-results" class="cot-results" role="listbox" aria-label="Productos disponibles"></div><div class="cot-picker-pages"></div><p class="cot-picker-status" role="status" aria-live="polite"></p></div></div><p id="cot-product-selected" class="cot-hint">Precios sin IVA · disponibilidad actual del catálogo.</p></div>
<div><label class="form-label" for="cot-quantity">Cantidad</label><input type="number" id="cot-quantity" class="form-control" min="1" max="2147483647" step="1" value="1"></div><div><label class="form-label" for="cot-discount">Descuento %</label><input type="number" id="cot-discount" class="form-control" min="0" max="<%= politica.MaxDescuento %>" step="0.01" value="0"></div><button id="cot-add" type="button" class="btn btn-outline-primary"><span aria-hidden="true">+</span> Agregar</button></div>
<div class="cot-ledger-scroll"><table class="cot-ledger"><caption class="visually-hidden">Productos seleccionados. Cantidad y descuento editables.</caption><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Descuento</th><th>Importe neto</th><th><span class="visually-hidden">Acciones</span></th></tr></thead><tbody id="cot-lines"></tbody></table></div>
<div id="cot-empty" class="cot-empty"><div class="cot-empty-symbol" aria-hidden="true"><%- include('../partials/icon',{nombre:'box'}) %></div><h3>Tu propuesta empieza aquí</h3><p>Busca un producto y agrégalo a la cotización.</p></div><div class="cot-ledger-footer"><span id="cot-line-count">0 productos</span><span>Descuento autorizado: hasta <%= politica.MaxDescuento %>%</span></div></section></div>
<aside class="cot-summary" aria-labelledby="cot-summary-title"><div class="cot-summary-heading"><span class="cot-section-index">03</span><h2 id="cot-summary-title">Resumen comercial</h2><span>GTQ</span></div><p class="cot-summary-client" id="cot-summary-client">Selecciona un cliente</p><dl class="cot-totals"><div><dt>Subtotal</dt><dd id="cot-gross">Q 0.00</dd></div><div><dt>Descuentos</dt><dd id="cot-saving">Q 0.00</dd></div><div><dt>Subtotal neto</dt><dd id="cot-net">Q 0.00</dd></div><div><dt>IVA <small>12%</small></dt><dd id="cot-tax">Q 0.00</dd></div></dl><div class="cot-grand-total"><span>Total de la propuesta</span><strong id="cot-total">Q 0.00</strong></div><button id="cot-save" class="btn btn-primary w-100">Guardar cotización <span aria-hidden="true">→</span></button><p class="cot-summary-note">Vista previa. El precio y los importes definitivos se validan al guardar.</p><div class="cot-summary-foot"><span class="cot-dot"></span>Sin reserva de inventario</div><details class="cot-technical"><summary>Información de operación</summary><span class="cot-reference"><%= operacionId %></span></details></aside></div></form></main></body></html>
