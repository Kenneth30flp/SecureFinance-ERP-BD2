<%- include('head',{title:'Nueva cotización'}) %>
<noscript><p class="alert alert-warning">Activa JavaScript para preparar la cotización.</p></noscript>
<form id="cot-create" data-operation="<%= operacionId %>" data-max-discount="<%= politica.MaxDescuento %>"><div class="cot-layout"><div>
<section class="work-panel"><div class="panel-body"><h2 class="h5">Cliente y vigencia</h2><div class="cot-filters"><label>Cliente activo<select class="form-select" id="cot-client" required><option value="">Selecciona un cliente</option><% clientes.forEach(c=>{ %><option value="<%= c.ClienteId %>"><%= c.Nombre %> · <%= c.NIT %></option><% }); %></select></label>
<label>Válida hasta · Guatemala<input id="cot-expiry" type="date" class="form-control" required></label></div><p class="summary-note">Vigencia hasta finalizar el día indicado. SQL Server verifica un máximo de 90 días; emitir no reserva stock.</p><label for="cot-notes">Observaciones</label><textarea id="cot-notes" maxlength="1000" class="form-control" rows="3"></textarea></div></section>
<section class="work-panel"><div class="panel-body"><h2 class="h5">Productos cotizados</h2><label for="cot-search">Buscar por SKU o descripción</label><input id="cot-search" type="search" class="form-control" autocomplete="off"><div class="cot-product-entry"><label>Producto<select id="cot-product" class="form-select"><option value="">Selecciona un producto</option><% productos.forEach(p=>{ %><option value="<%= p.ProductoId %>" data-sku="<%= p.Codigo %>" data-description="<%= p.Descripcion %>" data-price="<%= p.Precio %>"><%= p.Codigo %> · <%= p.Descripcion %> · Q <%= p.Precio %> · stock <%= p.Stock %></option><% }); %></select></label><label>Cantidad<input type="number" id="cot-quantity" class="form-control" min="1" max="2147483647" step="1" value="1"></label><label>Descuento %<input type="number" id="cot-discount" class="form-control" min="0" max="<%= politica.MaxDescuento %>" step="0.01" value="0"></label><button id="cot-add" type="button" class="btn btn-outline-primary">Agregar producto</button></div>
<p class="summary-note">Máximo autorizado: <%= politica.MaxDescuento %>%. Precio sin IVA leído del catálogo; SQL fija el valor definitivo al guardar.</p>
<div class="table-responsive" tabindex="0" role="region" aria-label="Líneas de cotización"><table class="table table-modern"><caption>Vista previa de importes, sujeta a validación SQL.</caption><thead><tr><th>Producto / SKU</th><th>Cantidad</th><th>Precio Q</th><th>Descuento %</th><th>Neto Q</th><th>Acción</th></tr></thead><tbody id="cot-lines"></tbody></table></div><p id="cot-empty" class="empty-state">Agrega al menos un producto.</p></div></section></div>
<aside class="work-panel cot-summary"><div class="panel-body"><p class="eyebrow">Propuesta comercial</p><h2 class="h5">Resumen preliminar</h2><dl class="cot-totals"><div><dt>Subtotal</dt><dd id="cot-gross">Q 0.00</dd></div><div><dt>Descuentos</dt><dd id="cot-saving">Q 0.00</dd></div><div><dt>Neto</dt><dd id="cot-net">Q 0.00</dd></div><div><dt>IVA 12%</dt><dd id="cot-tax">Q 0.00</dd></div><div class="cot-total"><dt>Total</dt><dd id="cot-total">Q 0.00</dd></div></dl><p>Documento interno. No constituye factura ni acredita pago.</p><button id="cot-save" class="btn btn-primary w-100">Guardar cotización</button><p class="summary-note">Referencia: <span class="cot-reference"><%= operacionId %></span></p></div></aside>
</div></form></main></body></html>
