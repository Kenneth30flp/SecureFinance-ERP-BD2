<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const titulo = modo === 'recuperar' ? 'RECUPERAR ACCESO' : modo === 'restablecer' ? 'NUEVA CONTRASEÑA' : 'CAMBIAR CONTRASEÑA'; %>
  <title><%= titulo %> | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="login-page">
  <main class="login-portal">
    <header class="portal-header"><a class="brand-title" href="/login"><svg class="brand-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M23 8H9v15h14v17H7M30 40V8h13M30 23h11" stroke="currentColor" stroke-width="4"/><path d="M7 31h9M37 33h6" stroke="var(--copper-soft)" stroke-width="3"/></svg><span>SecureFinance<small>ERP / Financial operations desk</small></span></a><span class="portal-reference">SEGURIDAD DE ACCESO</span></header>
    <div class="portal-title"><p class="eyebrow">CONTROL DE ACCESO</p><h1>Tu acceso.<br>Tu seguridad.</h1><p>Protege tu cuenta y continúa con tus operaciones.</p></div>
    <section class="portal-access" aria-labelledby="access-title">
      <div class="access-heading"><span class="section-index">02 / SEGURIDAD</span><h2 id="access-title"><%= titulo %></h2>
        <p><%= modo === 'recuperar' ? 'Solicita un enlace para recuperar tu acceso.' : obligatorio ? 'Actualiza tu contraseña antes de continuar al sistema.' : 'Utiliza una contraseña de entre 8 y 128 caracteres.' %></p>
      </div>
      <% if (error) { %><div class="alert desk-message alert-danger" data-marker="×" role="alert"><%= error %></div><% } %>
      <% if (mensaje) { %><div class="alert desk-message alert-success" data-marker="✓" role="status"><%= mensaje %></div><% } %>
      <% if (demoUrl) { %>
        <div class="recovery-demo"><p class="eyebrow">DEMOSTRACIÓN ACADÉMICA / DESARROLLO</p><p>Enlace de un solo uso, válido durante 15 minutos.</p><a class="access-link" href="<%= demoUrl %>">Abrir enlace de recuperación</a></div>
      <% } %>
      <% if (!completado && valido) { %>
        <form method="post" action="/<%= modo === 'recuperar' ? 'recuperar-password' : modo === 'restablecer' ? 'restablecer-password' : 'cambiar-password' %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (modo === 'recuperar') { %>
            <div class="mb-4"><label class="form-label" for="identificador">Usuario o correo</label><input class="form-control" id="identificador" name="UsuarioOCorreo" type="text" autocomplete="username" maxlength="254" required autofocus></div>
          <% } else { %>
            <% if (modo === 'restablecer') { %><input type="hidden" name="token" value="<%= token %>"><% } %>
            <% if (modo === 'cambiar') { %>
              <div class="mb-3"><label class="form-label" for="password-actual">Contraseña actual</label><input class="form-control" id="password-actual" name="PasswordActual" type="password" autocomplete="current-password" maxlength="128" required autofocus></div>
            <% } %>
            <div class="mb-3"><label class="form-label" for="password-nueva">Nueva contraseña</label><input class="form-control" id="password-nueva" name="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required aria-describedby="password-ayuda"></div>
            <div class="mb-4"><label class="form-label" for="password-confirmar">Confirmar <%= modo === 'cambiar' ? 'nueva contraseña' : 'contraseña' %></label><input class="form-control" id="password-confirmar" name="ConfirmarPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required><p id="password-ayuda" class="password-help">Entre 8 y 128 caracteres. Evita reutilizar contraseñas.</p></div>
          <% } %>
          <button class="btn btn-primary w-100 py-2" type="submit"><%= modo === 'recuperar' ? 'Generar recuperación' : 'Actualizar contraseña' %></button>
        </form>
      <% } %>
      <% if (modo === 'restablecer' && !valido && !completado) { %><a class="access-link" href="/recuperar-password">Solicitar otro enlace</a><% } %>
      <% if (modo === 'cambiar' && !obligatorio) { %><a class="access-link" href="/dashboard">Volver al dashboard</a><% } %>
      <a class="access-link" href="<%= modo === 'cambiar' ? '/logout' : '/login' %>">Volver al inicio de sesión</a>
    </section>
    <footer class="portal-footer"><span>SECUREFINANCE ERP</span><span>Operación / Control / Trazabilidad</span></footer>
  </main>
</body>
</html>
