<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Usuarios y Roles | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/visual.js" defer></script>
</head>
<body class="app-shell usuarios-workspace">
<a class="skip-link" href="#workspace">Ir al contenido</a>
  <%- include('partials/navigation', { actual: 'usuarios', rolesCuenta: usuarios.find(u => u.UsuarioId === usuario.usuarioId)?.Roles || '' }) %>

  <main tabindex="-1" id="workspace" class="container page-content">
    <div class="page-header"><p class="eyebrow">Identity governance center</p><h1>Gobierno de accesos</h1><p>Identidades, roles y alcance de acceso del sistema</p></div>
    <div id="roles-message" role="status" aria-live="polite" hidden></div>
    <div class="governance-layout"><aside class="governance-brief"><span class="governance-emblem"><%- include('partials/icon',{nombre:'shield'}) %></span><h2>Contexto de acceso</h2><dl class="governance-context"><div><dt>Cuenta actual</dt><dd><%= usuario.nombreUsuario %></dd></div><div><dt>Roles</dt><dd><%= usuarios.find(u => u.UsuarioId === usuario.usuarioId)?.Roles || 'Sin roles activos' %></dd></div><div><dt>Permisos asignados</dt><dd><%= usuario.permisos.length %></dd></div></dl><div class="governance-note"><%- include('partials/icon',{nombre:'key'}) %><p>Los permisos asignados se aplican en la próxima sesión.</p></div></aside><section class="log-panel"><div class="panel-body"><h2>Directorio de identidades</h2>
      <div class="table-responsive" tabindex="0" role="region" aria-label="Usuarios del sistema"><table class="table table-modern align-middle">
        <thead><tr><th scope="col">Usuario</th><th scope="col">Nombre</th><th scope="col">Correo</th><th scope="col">Estado</th><th scope="col">Roles</th><th scope="col">Acción</th></tr></thead>
        <tbody><% usuarios.forEach(u => { %><tr>
          <td><div class="table-identity"><span class="identity-avatar" aria-hidden="true"><%= u.NombreUsuario.slice(0,2).toUpperCase() %></span><strong><%= u.NombreUsuario %></strong></div></td><td><%= u.NombreCompleto %></td><td><%= u.Correo %></td>
          <td><span class="status-badge <%= u.Activo ? 'status-success' : 'status-neutral' %>"><%= u.Activo ? 'Activo' : 'Inactivo' %></span></td>
          <td><%= u.Roles || 'Sin roles activos' %></td><td><button type="button" class="btn btn-outline-primary btn-sm" aria-haspopup="dialog" aria-controls="roles-panel" data-user-id="<%= u.UsuarioId %>" data-user-name="<%= u.NombreUsuario %>" data-user-fullname="<%= u.NombreCompleto %>" data-user-active="<%= u.Activo ? 'Activo' : 'Inactivo' %>">Administrar roles</button></td>
        </tr><% }); %></tbody>
      </table></div><% if (!usuarios.length) { %><p class="empty-state">No hay usuarios.</p><% } %>
    </div></section></div>
    <dialog id="roles-panel" class="operation-dialog access-dialog" aria-labelledby="roles-title">
      <div class="dialog-heading"><span class="dialog-emblem"><%- include('partials/icon',{nombre:'users'}) %></span><p class="eyebrow">Administración / Identidad y acceso</p><h2 id="roles-title" tabindex="-1">Administrar acceso</h2></div>
      <dl class="access-identity"><dt>Usuario</dt><dd id="selected-user"></dd><dt>Nombre</dt><dd id="selected-fullname"></dd><dt>Estado</dt><dd id="selected-state"></dd></dl>
      <div id="roles-dialog-message" role="alert" hidden></div>
      <form id="roles-form" data-csrf="<%= csrf %>"><fieldset><legend>Roles disponibles</legend>
        <% roles.forEach(r => { %><label class="role-option"><input type="checkbox" name="Roles" value="<%= r.RolId %>"><span><strong><%= r.Nombre %></strong><small><%= r.Descripcion || '' %></small></span></label><% }); %>
      </fieldset><div class="alert desk-message alert-info" data-marker="i" role="note">Los permisos se actualizarán en la próxima sesión.</div>
      <div class="role-actions"><button id="cancel-roles" type="button" class="btn btn-outline-primary">Cancelar</button><button id="save-roles" type="submit" class="btn btn-primary">Guardar cambios</button></div></form>
    </dialog>
  </main><script src="/js/messages.js" defer></script><script src="/js/usuarios.js" defer></script>
</body></html>
