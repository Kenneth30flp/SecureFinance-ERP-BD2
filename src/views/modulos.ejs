<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Centro de módulos | SecureFinance ERP</title><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/css/styles.css"></head><body class="app-shell"><a class="skip-link" href="#workspace">Ir al contenido</a><%- include('partials/navigation',{actual:'modulos',rolesCuenta:''}) %><main id="workspace" class="container page-content" tabindex="-1"><header class="module-heading"><p class="eyebrow">SECUREFINANCE ERP / ESPACIO DE TRABAJO</p><h1>Centro de módulos</h1><p>Encuentra las herramientas de tu operación, organizadas por área.</p></header><div class="module-grid"><% moduleAreas(usuario).forEach(area=>{ %><section class="module-area" id="area-<%= area.id %>" aria-labelledby="title-<%= area.id %>"><header><%- include('partials/icon',{nombre:area.icon}) %><h2 id="title-<%= area.id %>"><%= area.name %></h2><span><%= area.modules.length %></span></header><% if(!area.modules.length){ %><p class="module-empty">Tu cuenta no tiene funciones habilitadas en esta área.</p><% } %><% area.modules.forEach(m=>{ %><a class="module-entry" href="<%= m.route %>"><%- include('partials/icon',{nombre:m.icon}) %><span><strong><%= m.name %></strong><small><%= m.description %></small></span><span aria-hidden="true">↗</span></a><% }); %></section><% }); %></div></main></body></html>
