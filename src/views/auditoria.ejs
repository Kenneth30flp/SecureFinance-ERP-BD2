<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Auditoría | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/visual.js" defer></script>
</head>
<body class="app-shell auditoria-workspace">
<a class="skip-link" href="#workspace">Ir al contenido</a>
  <%- include('partials/navigation', { actual: 'auditoria', rolesCuenta: '' }) %>

  <main tabindex="-1" id="workspace" class="container audit-content page-content">
    <% const jsonLegible = (valor) => { if (!valor) return 'Sin valor'; try { return JSON.stringify(JSON.parse(valor), null, 2); } catch { return String(valor); } }; %>
    <% const fechaLegible = (valor) => { const fecha = new Date(valor); return valor && !Number.isNaN(fecha.getTime()) ? fecha.toLocaleString('es-GT', { timeZone: 'America/Guatemala' }) : '-'; }; %>
    <div class="page-header"><p class="eyebrow mb-2">Compliance operations center</p>
    <h1 class="h2 fw-bold mb-2">Control y trazabilidad</h1><p class="text-secondary">Control y trazabilidad del sistema</p></div>

    <% if (error) { %><div class="alert desk-message alert-danger" data-marker="×" role="alert"><%= error %> <a href="/auditoria">Intentar nuevamente</a></div><% } else { %>
    <dl class="audit-metrics" aria-label="Registros mostrados"><div><dt>Accesos registrados</dt><dd><%= bitacoraAcceso.length %></dd></div><div><dt>Eventos DML</dt><dd><%= auditoriaDml.length %></dd></div><div><dt>Ventas mostradas</dt><dd><%= historicoVentas.length %></dd></div></dl>
<div class="audit-workspace">    <aside class="filter-panel" aria-label="Filtros de auditoría">
      <div class="panel-body">
        <h2 class="h5 mb-3"><%- include('partials/icon',{nombre:'filter'}) %>Filtros · <%= ({ acceso: 'Bitácora de acceso', dml: 'Auditoría DML', ventas: 'Histórico de ventas' })[vista] %></h2>
        <form method="GET" action="/auditoria" class="filter-grid">
          <input type="hidden" name="vista" value="<%= vista %>">
          <div class="filter-field">
            <label class="form-label" for="fechaInicial">Fecha inicial</label>
            <input id="fechaInicial" class="form-control" type="date" name="fechaInicial" value="<%= filtros.fechaInicial || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="fechaFinal">Fecha final</label>
            <input id="fechaFinal" class="form-control" type="date" name="fechaFinal" value="<%= filtros.fechaFinal || '' %>">
          </div>
          <% if (vista === 'acceso') { %>
          <div class="filter-field">
            <label class="form-label" for="usuario">Usuario intentado</label>
            <input id="usuario" class="form-control" type="text" name="usuario" maxlength="50" value="<%= filtros.usuario || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="resultado">Resultado</label>
            <select id="resultado" class="form-select" name="resultado"><option value="">Todos</option>
              <% ['EXITOSO', 'PASSWORD_INCORRECTA', 'USUARIO_INEXISTENTE', 'USUARIO_INACTIVO'].forEach((valor) => { %>
                <option value="<%= valor %>" <%= filtros.resultado === valor ? 'selected' : '' %>><%= valor %></option>
              <% }); %>
            </select>
          </div>
          <% } else if (vista === 'dml') { %>
          <div class="filter-field">
            <label class="form-label" for="tabla">Tabla</label>
            <input id="tabla" class="form-control" type="text" name="tabla" maxlength="128" value="<%= filtros.tabla || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="operacion">Operación</label>
            <select id="operacion" class="form-select" name="operacion"><option value="">Todas</option>
              <% ['INSERT', 'UPDATE', 'DELETE'].forEach((valor) => { %><option value="<%= valor %>" <%= filtros.operacion === valor ? 'selected' : '' %>><%= valor %></option><% }); %>
            </select>
          </div>
          <% } else { %>
          <div class="filter-field">
            <label class="form-label" for="cliente">Cliente</label>
            <input id="cliente" class="form-control" type="text" name="cliente" maxlength="150" value="<%= filtros.cliente || '' %>">
          </div>
          <% } %>
          <div class="filter-submit">
            <button class="btn btn-primary" type="submit">Aplicar filtros</button>
            <a class="btn btn-outline-primary" href="/auditoria?vista=<%= vista %>">Limpiar filtros</a>
          </div>
        </form>
      </div>
        <p class="audit-context">Los filtros se aplican únicamente a la vista seleccionada. Fechas de filtro en UTC; horarios de Guatemala (UTC−6).</p></aside><div class="audit-records">    <nav class="audit-subnav" aria-label="Vistas de auditoría">
      <% [['acceso', '01', 'Bitácora de acceso'], ['dml', '02', 'Auditoría DML'], ['ventas', '03', 'Histórico de ventas']].forEach(([clave, indice, titulo]) => { %>
        <a href="/auditoria?vista=<%= clave %>" <%- vista === clave ? 'aria-current="page"' : '' %>><%- include('partials/icon',{nombre: clave === 'acceso' ? 'key' : clave === 'dml' ? 'activity' : 'receipt'}) %><%= titulo %><small class="tab-count" aria-label="Registros"><%= ({ acceso: bitacoraAcceso.length, dml: auditoriaDml.length, ventas: historicoVentas.length })[clave] %></small></a>
      <% }); %>
    </nav>


    <% if (vista === 'acceso') { %>
    <section class="log-panel" id="vista-acceso">
      <div class="panel-body">
        <h2 class="h5 mb-3">BITÁCORA DE ACCESO</h2>
        <% if (bitacoraAcceso.length) { %>
          <div class="table-responsive audit-scroll" tabindex="0" role="region" aria-label="Bitácora de acceso">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th scope="col">Fecha y hora</th>
                  <th scope="col">Usuario intentado</th>
                  <th scope="col">Resultado</th>
                  <th scope="col">Equipo</th>
                  <th scope="col">Aplicación</th>
                  <th scope="col">Usuario SQL</th>
                  <th scope="col">IP de conexión SQL</th>
                </tr>
              </thead>
              <tbody>
                <% bitacoraAcceso.forEach((registro) => { %>
                  <tr>
                    <td class="timestamp"><%= fechaLegible(registro.FechaHora) %></td>
                    <td><%= registro.NombreUsuarioIntentado %></td>
                    <td><span class="status-badge <%= ({ EXITOSO: 'status-success', PASSWORD_INCORRECTA: 'status-danger', USUARIO_INACTIVO: 'status-warning', USUARIO_INEXISTENTE: 'status-danger' })[registro.Resultado] || 'status-neutral' %>"><%= registro.Resultado %></span></td>
                    <td><%= registro.HostName || '-' %></td>
                    <td><%= registro.AppName || '-' %></td>
                    <td><%= registro.UsuarioSQL || '-' %></td>
                    <td><%= registro.IpConexionSQL || '-' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state mb-0">No hay registros de acceso.</p>
        <% } %>
      </div>
    </section>

    <% } else if (vista === 'dml') { %>
    <section class="log-panel" id="vista-dml">
      <div class="panel-body">
        <h2 class="h5 mb-3">AUDITORÍA DML</h2>
        <% if (auditoriaDml.length) { %>
          <div class="table-responsive audit-scroll" tabindex="0" role="region" aria-label="Registros DML">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th scope="col">Fecha y hora</th>
                  <th scope="col">Tabla afectada</th>
                  <th scope="col">Operación</th>
                  <th scope="col">Identificador</th>
                  <th scope="col">Usuario SQL</th>
                  <th scope="col">Equipo</th>
                  <th scope="col">Aplicación</th>
                  <th scope="col">Valor anterior</th>
                  <th scope="col">Valor nuevo</th>
                </tr>
              </thead>
              <tbody>
                <% auditoriaDml.forEach((registro) => { %>
                  <tr>
                    <td class="timestamp"><%= fechaLegible(registro.FechaHora) %></td>
                    <td><%= registro.TablaAfectada || '-' %></td>
                    <td><span class="status-badge <%= ({ INSERT: 'status-success', UPDATE: 'status-info', DELETE: 'status-danger' })[registro.Operacion] || 'status-neutral' %>"><%= registro.Operacion || '-' %></span></td>
                    <td class="record-id"><%= registro.IdentificadorRegistro || '-' %></td>
                    <td><%= registro.UsuarioSQL || '-' %></td>
                    <td><%= registro.HostName || '-' %></td>
                    <td><%= registro.AppName || '-' %></td>
                    <td><details class="json-disclosure"><summary>Valor anterior</summary><pre class="json-value" tabindex="0"><code><%= jsonLegible(registro.ValorAnterior) %></code></pre></details></td>
                    <td><details class="json-disclosure"><summary>Valor nuevo</summary><pre class="json-value json-after" tabindex="0"><code><%= jsonLegible(registro.ValorNuevo) %></code></pre></details></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state mb-0">No hay registros de auditoría DML.</p>
        <% } %>
      </div>
    </section>

    <% } else { %>
    <section class="log-panel" id="vista-ventas">
      <div class="panel-body">
        <h2 class="h5 mb-3">HISTÓRICO DE VENTAS</h2>
        <% if (historicoVentas.length) { %>
          <div class="table-responsive audit-scroll" tabindex="0" role="region" aria-label="Histórico de ventas">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th scope="col">Factura</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Cliente</th>
                  <th scope="col">Usuario</th>
                  <th scope="col" class="text-end">Subtotal bruto</th>
                  <th scope="col" class="text-end">Descuento</th>
                  <th scope="col" class="text-end">Subtotal neto</th>
                  <th scope="col" class="text-end">IVA</th>
                  <th scope="col" class="text-end">Total</th>
                </tr>
              </thead>
              <tbody>
                <% historicoVentas.forEach((registro) => { %>
                  <tr>
                    <td><%= registro.Factura || '-' %></td>
                    <td class="timestamp"><%= fechaLegible(registro.Fecha) %></td>
                    <td><%= registro.Cliente || '-' %></td>
                    <td><%= registro.Usuario || '-' %></td>
                    <td class="money-cell"><%= registro.Subtotal == null ? '-' : 'Q ' + registro.Subtotal %></td>
                    <td class="money-cell discount-reduction"><%= registro.Descuento == null ? '-' : '- Q ' + registro.Descuento %></td>
                    <td class="money-cell"><%= registro.SubtotalNeto == null ? '-' : 'Q ' + registro.SubtotalNeto %></td>
                    <td class="money-cell"><%= registro.IVA == null ? '-' : 'Q ' + registro.IVA %></td>
                    <td class="money-cell sale-history-total"><%= registro.Total == null ? '-' : 'Q ' + registro.Total %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state mb-0">No hay histórico de ventas disponible.</p>
        <% } %>
      </div>
    </section>
    <% } %>
    </div></div>
    <% } %>
  </main>
</body>
</html>
