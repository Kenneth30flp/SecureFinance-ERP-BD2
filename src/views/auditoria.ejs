<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Auditoría | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="app-shell">
<a class="skip-link" href="#workspace">Ir al contenido</a>
  <aside class="sidebar">
    <a class="brand-title" href="/dashboard"><svg class="brand-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M23 8H9v15h14v17H7M30 40V8h13M30 23h11" stroke="currentColor" stroke-width="4"/><path d="M7 31h9M37 33h6" stroke="var(--copper-soft)" stroke-width="3"/></svg><span>SecureFinance<small>ERP / Operations desk</small></span></a>
    <p class="nav-label">ÁREA DE TRABAJO</p>
    <nav class="desk-nav" aria-label="Principal">
      <a href="/dashboard" ><span>00</span>Dashboard</a>
      <% if (usuario.permisos.includes('VENTAS_REGISTRAR')) { %><a href="/facturacion" ><span>01</span>Facturación</a><% } %>
      <% if (usuario.permisos.includes('AUDITORIA_CONSULTAR')) { %><a href="/auditoria" aria-current="page"><span>02</span>Auditoría</a><% } %>
    </nav>
    <div class="sidebar-account"><span class="nav-label">USUARIO ACTUAL</span><strong><%= usuario.nombreUsuario %></strong><a class="btn btn-nav" href="/logout">Cerrar sesión <span aria-hidden="true">&nearr;</span></a></div>
    <span class="sidebar-foot">SECUREFINANCE / ERP</span>
  </aside>

  <main id="workspace" class="container audit-content page-content">
    <div class="page-header"><p class="eyebrow mb-2">CONTROL / 02 · Observabilidad</p>
    <h1 class="h2 fw-bold mb-2">AUDITORÍA</h1><p class="text-secondary">Control y trazabilidad del sistema</p></div>

    <dl class="audit-metrics" aria-label="Registros mostrados"><div><dt>Accesos registrados</dt><dd><%= bitacoraAcceso.length %></dd></div><div><dt>Eventos DML</dt><dd><%= auditoriaDml.length %></dd></div><div><dt>Ventas mostradas</dt><dd><%= historicoVentas.length %></dd></div></dl>
    <section class="filter-panel">
      <div class="panel-body">
        <h2 class="h5 mb-3">Filtros</h2>
        <form method="GET" action="/auditoria" class="filter-grid">
          <div class="filter-field">
            <label class="form-label" for="fechaInicial">Fecha inicial</label>
            <input id="fechaInicial" class="form-control" type="date" name="fechaInicial" value="<%= filtros.fechaInicial || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="fechaFinal">Fecha final</label>
            <input id="fechaFinal" class="form-control" type="date" name="fechaFinal" value="<%= filtros.fechaFinal || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="tabla">Tabla</label>
            <input id="tabla" class="form-control" type="text" name="tabla" value="<%= filtros.tabla || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="operacion">Operación</label>
            <input id="operacion" class="form-control" type="text" name="operacion" value="<%= filtros.operacion || '' %>">
          </div>
          <div class="filter-field">
            <label class="form-label" for="cliente">Cliente</label>
            <input id="cliente" class="form-control" type="text" name="cliente" value="<%= filtros.cliente || '' %>">
          </div>
          <div class="filter-submit">
            <button class="btn btn-primary" type="submit">Aplicar filtros</button>
          </div>
        </form>
      </div>
    </section>

    <section class="log-panel">
      <div class="panel-body">
        <h2 class="h5 mb-3"><span class="section-index">01</span> BITÁCORA DE ACCESO</h2>
        <% if (bitacoraAcceso.length) { %>
          <div class="table-responsive" tabindex="0" role="region" aria-label="Bitácora de acceso">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th scope="col">Fecha y hora</th>
                  <th scope="col">Usuario intentado</th>
                  <th scope="col">Resultado</th>
                  <th scope="col">Equipo</th>
                  <th scope="col">Aplicación</th>
                  <th scope="col">Usuario SQL</th>
                  <th scope="col">IP de conexión SQL</th>
                </tr>
              </thead>
              <tbody>
                <% bitacoraAcceso.forEach((registro) => { %>
                  <tr>
                    <td class="timestamp"><%= registro.FechaHora %></td>
                    <td><%= registro.NombreUsuarioIntentado %></td>
                    <td><span class="status-badge <%= ({ EXITOSO: 'status-success', PASSWORD_INCORRECTA: 'status-danger', USUARIO_INACTIVO: 'status-warning', USUARIO_INEXISTENTE: 'status-neutral' })[registro.Resultado] || 'status-neutral' %>"><%= registro.Resultado %></span></td>
                    <td><%= registro.HostName || '-' %></td>
                    <td><%= registro.AppName || '-' %></td>
                    <td><%= registro.UsuarioSQL || '-' %></td>
                    <td><%= registro.IpConexionSQL || '-' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state mb-0">No hay registros de acceso.</p>
        <% } %>
      </div>
    </section>

    <section class="log-panel">
      <div class="panel-body">
        <h2 class="h5 mb-3"><span class="section-index">02</span> AUDITORÍA DML</h2>
        <% if (auditoriaDml.length) { %>
          <div class="table-responsive" tabindex="0" role="region" aria-label="Registros de auditoría">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th scope="col">Fecha y hora</th>
                  <th scope="col">Tabla afectada</th>
                  <th scope="col">Operación</th>
                  <th scope="col">Usuario SQL</th>
                  <th scope="col">Equipo</th>
                  <th scope="col">Valor anterior</th>
                  <th scope="col">Valor nuevo</th>
                </tr>
              </thead>
              <tbody>
                <% auditoriaDml.forEach((registro) => { %>
                  <tr>
                    <td class="timestamp"><%= registro.FechaHora %></td>
                    <td><%= registro.TablaAfectada || '-' %></td>
                    <td><span class="status-badge <%= ({ INSERT: 'status-success', UPDATE: 'status-info', DELETE: 'status-danger' })[registro.Operacion] || 'status-neutral' %>"><%= registro.Operacion || '-' %></span></td>
                    <td><%= registro.UsuarioSQL || '-' %></td>
                    <td><%= registro.HostName || '-' %></td>
                    <td><pre class="json-value" tabindex="0" role="region" aria-label="Valor anterior"><code><%= registro.ValorAnterior || '-' %></code></pre></td>
                    <td><pre class="json-value json-after" tabindex="0" role="region" aria-label="Valor nuevo"><code><%= registro.ValorNuevo || '-' %></code></pre></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state mb-0">No hay registros de auditoría DML.</p>
        <% } %>
      </div>
    </section>

    <section class="log-panel">
      <div class="panel-body">
        <h2 class="h5 mb-3"><span class="section-index">03</span> HISTÓRICO DE VENTAS</h2>
        <% if (historicoVentas.length) { %>
          <div class="table-responsive" tabindex="0" role="region" aria-label="Registros de auditoría">
            <table class="table table-modern align-middle">
              <thead>
                <tr>
                  <th scope="col">Factura</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Cliente</th>
                  <th scope="col">Usuario</th>
                  <th scope="col" class="text-end">Subtotal</th>
                  <th scope="col" class="text-end">IVA</th>
                  <th scope="col" class="text-end">Total</th>
                </tr>
              </thead>
              <tbody>
                <% historicoVentas.forEach((registro) => { %>
                  <tr>
                    <td><%= registro.Factura || '-' %></td>
                    <td class="timestamp"><%= registro.Fecha || '-' %></td>
                    <td><%= registro.Cliente || '-' %></td>
                    <td><%= registro.Usuario || '-' %></td>
                    <td class="money-cell"><%= registro.Subtotal == null ? '-' : 'Q ' + registro.Subtotal %></td>
                    <td class="money-cell"><%= registro.IVA == null ? '-' : 'Q ' + registro.IVA %></td>
                    <td class="money-cell sale-history-total"><%= registro.Total == null ? '-' : 'Q ' + registro.Total %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state mb-0">No hay histórico de ventas disponible.</p>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
