<%- include('partials/kenneth-head',{actual:'inventario',title:'Inventario',eyebrow:'Inventario / Operaciones',intro:'Existencias y movimientos en un mismo espacio de control.'}) %>
<div class="inventory-gate <%= state.Habilitado?'is-enabled':'is-disabled' %>"><%- include('partials/icon',{nombre:'activity'}) %><div><strong>Kardex <%= state.Habilitado?'habilitado':'deshabilitado' %></strong><span><%= state.Habilitado?'Movimientos disponibles según tus permisos.':'Consulta disponible. Los movimientos requieren apertura y habilitación por el responsable.' %></span></div></div>
<%- include('partials/kenneth-search',{actual:'inventario',label:'existencias',placeholder:'SKU o descripción'}) %>
<div class="inventory-layout"><section class="stock-directory" aria-label="Existencias por producto"><div class="directory-label"><span>Producto</span><span>Stock</span></div><% rows.forEach(p=>{const critical=p.Stock<=p.StockMinimo; %><a class="stock-entry <%= selected?.ProductoId===p.ProductoId?'is-selected':'' %>" href="/inventario?<%= new URLSearchParams({buscar:f.buscar||'',id:String(p.ProductoId),offset:String(f.offset||0)}).toString() %>" <%- selected?.ProductoId===p.ProductoId?'aria-current="true"':'' %>><div><span class="master-code"><%= p.Codigo %></span><h2><%= p.Descripcion %></h2><small><%= !p.Activo?'Inactivo':critical?'Stock crítico':p.Stock<=p.PuntoReorden?'Reorden recomendado':'Disponible' %></small></div><strong class="<%= critical?'critical-stock':'' %>"><%= p.Stock %></strong></a><% }); %><% if(!rows.length){ %><div class="master-empty"><h2>Sin existencias coincidentes</h2><p>Prueba otro código o descripción.</p></div><% } %><%- include('partials/kenneth-pagination',{label:'existencias'}) %></section>
<a class="btn btn-outline-secondary inventory-jump" href="#inventory-detail">Ver producto seleccionado e historial</a><section id="inventory-detail" class="inventory-detail" aria-label="Detalle y movimientos"><% if(selected){const p=selected; %><header class="stock-heading"><div><p class="master-code"><%= p.Codigo %></p><h2><%= p.Descripcion %></h2><p><%= p.Proveedor||'Sin proveedor asignado' %></p></div><div class="stock-total"><span>Existencia actual</span><strong><%= p.Stock %></strong><small>unidades</small></div></header><% if(p.Stock<=p.StockMinimo){ %><p class="stock-alert" role="status">Stock bajo: la existencia está en el mínimo o por debajo. Revisa el abastecimiento.</p><% } %><dl class="stock-policy"><div><dt>Stock mínimo</dt><dd><%= p.StockMinimo %></dd></div><div><dt>Punto de reorden</dt><dd><%= p.PuntoReorden %></dd></div><div><dt>Estado</dt><dd><%= p.Activo?'Activo':'Inactivo' %></dd></div></dl>
<% if(usuario.permisos.includes('INVENTARIO_REGISTRAR')||usuario.permisos.includes('INVENTARIO_AJUSTAR')){ %><details class="inventory-action"><summary>Ingresar existencias o registrar ajuste</summary><form method="post" data-master-form data-success="/inventario?id=" action="/inventario/movimientos"><fieldset <%= state.Habilitado&&p.Activo?'':'disabled' %>><legend class="visually-hidden">Movimiento de inventario</legend><input type="hidden" name="ProductoId" value="<%= p.ProductoId %>"><input type="hidden" name="Version" value="<%= p.Version %>"><input type="hidden" name="OperacionId" value="<%= operation %>"><div class="form-grid"><div class="master-field"><label for="TipoMovimiento">Tipo de movimiento</label><select class="form-select" name="TipoMovimiento" id="TipoMovimiento"><% if(usuario.permisos.includes('INVENTARIO_REGISTRAR')){ %><option value="COMPRA">Ingreso por compra</option><% } %><% if(usuario.permisos.includes('INVENTARIO_AJUSTAR')){ %><option value="AJUSTE_INGRESO">Ajuste de ingreso</option><option value="AJUSTE_EGRESO">Ajuste de egreso</option><% } %></select></div><div class="master-field" data-purchase-supplier><label for="ProveedorId">Proveedor de esta compra</label><select class="form-select" name="ProveedorId" id="ProveedorId"><option value="">Selecciona un proveedor</option><% suppliers.filter(s=>s.Activo).forEach(s=>{ %><option value="<%= s.ProveedorId %>"><%= s.Nombre %></option><% }); %></select><label for="supplier-search">Buscar por nombre o NIT</label><input class="form-control" id="supplier-search" type="search" maxlength="150"><button class="btn btn-outline-secondary" id="supplier-find" type="button">Buscar</button><small>Asocia este proveedor al mismo SKU sin cambiar el principal.</small><label for="CostoUnitario">Costo unitario documentado (opcional)</label><input class="form-control" id="CostoUnitario" name="CostoUnitario" type="number" min="0" step="0.01"><small>Deja vacío si se desconoce. No cambia el costo de catálogo.</small></div><%- include('partials/kenneth-field',{name:'Cantidad',label:'Cantidad',value:'',type:'number'}) %><%- include('partials/kenneth-field',{name:'DocumentoRespaldo',label:'Documento de respaldo',value:'',max:100}) %><%- include('partials/kenneth-field',{name:'Motivo',label:'Motivo',value:'',max:250}) %></div><p data-stock-preview="<%= p.Stock %>" role="status"></p><p class="operation-reference">Referencia de operación: <%= operation %></p><button class="btn btn-primary" type="submit">Registrar movimiento</button></fieldset></form><% if(!state.Habilitado||!p.Activo){ %><p class="alert alert-warning">No se pueden registrar movimientos: <%= !state.Habilitado?'Kardex deshabilitado.':'producto inactivo.' %></p><% } %></details><% } %>
<div class="history-heading"><div><p class="eyebrow">Trazabilidad de existencias</p><h2>Historial Kardex</h2></div><span>Solo lectura</span></div><form class="history-filter" method="get"><input type="hidden" name="id" value="<%= p.ProductoId %>"><input type="hidden" name="buscar" value="<%= f.buscar %>"><div><label for="desde">Desde (UTC)</label><input class="form-control" type="date" name="desde" id="desde" value="<%= f.desde %>"></div><div><label for="hasta">Hasta (UTC)</label><input class="form-control" type="date" name="hasta" id="hasta" value="<%= f.hasta %>"></div><button class="btn btn-outline-secondary">Filtrar movimientos</button><a class="btn btn-link" href="/inventario?id=<%= p.ProductoId %>">Limpiar fechas</a></form>
<p class="history-zone">Zona horaria: UTC (UTC+00:00). El filtro incluye el día final completo.</p><div class="master-table-scroll"><table class="table master-table kardex-table"><caption class="visually-hidden">Movimientos de <%= p.Descripcion %>, fechas UTC</caption><thead><tr><th scope="col">Fecha UTC</th><th scope="col">Movimiento</th><th scope="col">Documento</th><th scope="col">Actor</th><th scope="col" class="text-end">Ingreso</th><th scope="col" class="text-end">Egreso</th><th scope="col" class="text-end">Anterior</th><th scope="col" class="text-end">Resultante</th></tr></thead><tbody><% history.forEach(k=>{const out=['VENTA','AJUSTE_EGRESO'].includes(k.TipoMovimiento); %><tr><td><time datetime="<%= new Date(k.FechaHora).toISOString() %>"><%= new Date(k.FechaHora).toLocaleString('es-GT',{timeZone:'UTC'}) %></time></td><td><strong><%= k.TipoMovimiento.replaceAll('_',' ') %></strong><details><summary>Motivo</summary><p><%= k.Motivo %></p></details></td><td><%= k.DocumentoRespaldo %><br><small>Proveedor: <%= k.Proveedor||'Sin evidencia histórica' %></small><br><small>Operación: <%= k.OperacionId||'No disponible' %></small></td><td><%= k.Actor %></td><td class="text-end"><%= !out?k.Cantidad:'—' %></td><td class="text-end"><%= out?k.Cantidad:'—' %></td><td class="text-end"><%= k.StockAnterior %></td><td class="text-end"><strong><%= k.StockResultante %></strong></td></tr><% }); %></tbody></table></div><% if(!history.length){ %><div class="master-empty"><h3>Sin movimientos en este período</h3><p>Consulta otras fechas. El historial solo contiene movimientos registrados.</p></div><% } %><%- include('partials/kenneth-pagination',{label:'movimientos',historyPage:true,next:historyNext}) %>
<% } else { %><div class="master-empty"><h2>Control de existencias</h2><p>Selecciona un producto disponible para consultar su saldo y movimientos.</p></div><% } %></section></div><%- include('partials/kenneth-confirm') %></main></body></html>
