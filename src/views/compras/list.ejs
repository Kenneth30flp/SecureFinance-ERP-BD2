<%- include('head',{title:'Órdenes de compra',subtitle:'Controla lo solicitado, las aprobaciones y cada entrega de tus proveedores.'}) %>
<section class="com-panel"><header class="com-panel-heading"><div><h2>Documentos de abastecimiento</h2><p>Costos pactados · Trazabilidad por recepción</p></div><span class="com-muted">Página <%= f.pagina %></span></header>
<form method="get" action="/compras" class="com-filters"><div><label for="com-search">Orden, proveedor o NIT</label><input class="form-control" id="com-search" name="buscar" maxlength="150" placeholder="Buscar por número o proveedor" value="<%= f.buscar %>"></div><div><label for="com-state">Estado</label><select class="form-select" id="com-state" name="estado"><option value="">Todos los estados</option><% states.forEach(s=>{ %><option value="<%= s %>" <%= f.estado===s?'selected':'' %>><%= labels[s] %></option><% }); %></select></div><div class="com-filter-actions"><button class="btn btn-primary">Buscar</button><a href="/compras" class="btn btn-outline-secondary">Limpiar</a></div></form>
<% if(rows.length){ %><div class="com-table-wrap"><table class="com-table"><caption class="visually-hidden">Órdenes de compra, importes en quetzales y fechas de Guatemala</caption><thead><tr><th>Orden</th><th>Proveedor</th><th>Emisión</th><th>Total pactado</th><th>Estado</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><th scope="row"><a class="com-number" href="/compras/<%= r.OrdenCompraId %>"><%= r.Numero %></a><small><%= r.Creador %></small></th><td data-label="Proveedor"><strong><%= r.ProveedorNombre %></strong><small>NIT <%= r.ProveedorNIT %></small></td><td data-label="Emisión"><%- include('../partials/operational-date',{value:r.FechaCreacion}) %></td><td data-label="Total pactado" class="com-money"><%= comMoney(r.Total) %></td><td data-label="Estado"><span class="com-badge com-state-<%= r.Estado %>"><%= labels[r.Estado] %></span></td><td><a href="/compras/<%= r.OrdenCompraId %>" aria-label="Ver orden <%= r.Numero %>">Ver detalle →</a></td></tr><% }); %></tbody></table></div><% }else{ %><div class="com-empty"><%- include('../partials/icon',{nombre:'receipt'}) %><h2>No hay órdenes para esta búsqueda</h2><p>Prueba otros filtros o prepara una nueva orden para tu proveedor.</p><% if(usuario.permisos.includes('COMPRAS_CREAR')){ %><a class="btn btn-primary" href="/compras/nueva">Crear orden de compra</a><% } %></div><% } %>
<% const link=p=>'/compras?'+new URLSearchParams({buscar:f.buscar||'',estado:f.estado||'',pagina:String(p)}); %><nav class="com-pagination" aria-label="Paginación"><span><%= rows.length %> órdenes en esta página</span><div><% if(f.pagina>1){ %><a class="btn btn-outline-secondary" href="<%= link(f.pagina-1) %>">← Anterior</a><% } %><% if(next){ %><a class="btn btn-outline-secondary" href="<%= link(f.pagina+1) %>">Siguiente →</a><% } %></div></nav></section><%- include('foot') %>
