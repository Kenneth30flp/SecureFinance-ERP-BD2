<%- include('head',{title:orden.Numero,subtitle:'Documento de compra y seguimiento de las entregas del proveedor.'}) %>
<% const can=p=>usuario.permisos.includes(p),canReceive=can('COMPRAS_RECIBIR')&&can('INVENTARIO_REGISTRAR')&&['APROBADA','PARCIALMENTE_RECIBIDA'].includes(orden.Estado); %>
<div class="com-toolbar com-no-print"><a href="/compras">← Volver a órdenes</a><button type="button" class="btn btn-outline-primary" data-print>Imprimir orden</button></div>
<div class="com-detail-layout"><article class="com-document"><header class="com-document-heading"><div><p class="eyebrow">SECUREFINANCE ERP · ORDEN DE COMPRA</p><h2><%= orden.Numero %></h2><p>Solicitud de abastecimiento</p></div><span class="com-badge com-state-<%= orden.Estado %>"><%= labels[orden.Estado] %></span></header>
<div class="com-document-meta"><div><span>PROVEEDOR</span><strong><%= orden.ProveedorNombre %></strong><small>NIT <%= orden.ProveedorNIT %></small></div><div><span>FECHA DE EMISIÓN</span><strong><%- include('../partials/operational-date',{value:orden.FechaCreacion}) %></strong></div><div><span>RESPONSABLE</span><strong><%= orden.Creador || orden.CreadorUsuarioId %></strong></div></div>
<div class="com-table-wrap"><table class="com-table com-lines"><caption class="visually-hidden">Líneas, costos pactados y cantidades pendientes</caption><thead><tr><th>Producto</th><th>Solicitado</th><th>Recibido</th><th>Pendiente</th><th>Costo pactado</th><th>Subtotal</th></tr></thead><tbody><% detalle.forEach(d=>{ %><tr><th scope="row"><%= d.Descripcion %><small><%= d.SKU %> <a class="com-no-print" href="/compras/valoracion/<%= d.ProductoId %>">· Ver valoración</a></small></th><td data-label="Solicitado"><%= d.Cantidad %></td><td data-label="Recibido"><%= d.Recibido %></td><td data-label="Pendiente"><strong><%= d.Pendiente %></strong></td><td class="com-money" data-label="Costo pactado"><%= comMoney(d.CostoUnitario) %></td><td class="com-money" data-label="Subtotal"><%= comMoney(d.Subtotal) %></td></tr><% }); %></tbody></table></div>
<div class="com-document-bottom"><div><h3>Observaciones</h3><p class="com-notes"><%= orden.Observaciones || 'Sin observaciones adicionales.' %></p><p class="com-help">Documento de compra. No acredita pago ni sustituye el comprobante del proveedor.</p></div><div class="com-total"><span>Total pactado</span><strong><%= comMoney(orden.Total) %></strong></div></div><footer>Inventario global · Importes en quetzales · Costos pactados conservados al emitir</footer></article>
<aside class="com-panel com-actions com-no-print"><p class="eyebrow">SIGUIENTE PASO</p><h2>Gestionar la orden</h2><p><%= orden.Estado==='BORRADOR'?'Revisa el documento y envíalo a aprobación.':orden.Estado==='PENDIENTE_APROBACION'?'Un responsable autorizado, distinto del creador, debe revisar esta orden.':canReceive?'Registra únicamente las cantidades que recibiste físicamente.':'Consulta el documento y su historial de operaciones.' %></p>
<% const actions=[];if(can('COMPRAS_CREAR')&&orden.Estado==='BORRADOR')actions.push(['enviar','Enviar a aprobación']);if(can('COMPRAS_APROBAR')&&orden.Estado==='PENDIENTE_APROBACION'&&usuario.usuarioId!==orden.CreadorUsuarioId)actions.push(['aprobar','Aprobar orden']);if(can('COMPRAS_CANCELAR')&&['BORRADOR','PENDIENTE_APROBACION','APROBADA'].includes(orden.Estado))actions.push(['cancelar','Cancelar orden']); %>
<% if(actions.length){ %><form data-state-form data-id="<%= orden.OrdenCompraId %>" data-version="<%= orden.Version %>" data-operation="<%= operacionId %>"><label for="com-reason">Motivo de la operación</label><textarea class="form-control" id="com-reason" name="Motivo" maxlength="250" rows="3" required></textarea><% actions.forEach(([action,label])=>{ %><button class="btn <%= action==='cancelar'?'btn-outline-danger':'btn-primary' %> w-100" type="submit" data-action="<%= action %>"><%= label %></button><% }); %></form><% } %><% if(canReceive){ %><a class="btn btn-primary w-100" href="#com-receive">Registrar entrega ↓</a><% } %><% if(orden.Estado==='PENDIENTE_APROBACION'&&usuario.usuarioId===orden.CreadorUsuarioId){ %><p class="com-help">La aprobación corresponde a otra persona autorizada.</p><% } %></aside></div>
<% if(canReceive){ %><section class="com-panel com-section com-no-print" id="com-receive"><header class="com-section-heading"><span>↓</span><div><h2>Registrar recepción</h2><p>Deja la cantidad vacía para productos no entregados. Los costos deben corresponder al documento real.</p></div></header><form data-receive-form data-id="<%= orden.OrdenCompraId %>" data-version="<%= orden.Version %>" data-operation="<%= operacionId %>"><div class="com-two-columns"><div><label for="com-document">Documento de respaldo</label><input class="form-control" id="com-document" name="DocumentoRespaldo" maxlength="100" placeholder="Factura, remisión o comprobante del proveedor" required></div><div><label for="com-receive-reason">Motivo / observación de entrega</label><input class="form-control" id="com-receive-reason" name="Motivo" maxlength="250" required></div></div><div class="com-table-wrap"><table class="com-table com-lines"><caption class="visually-hidden">Productos pendientes de recibir</caption><thead><tr><th>Producto</th><th>Pendiente</th><th>Recibir ahora</th><th>Costo documentado (Q)</th></tr></thead><tbody><% detalle.filter(d=>Number(d.Pendiente)>0).forEach(d=>{ %><tr data-receive-line="<%= d.ProductoId %>"><th scope="row"><%= d.Descripcion %><small><%= d.SKU %></small></th><td data-label="Pendiente"><%= d.Pendiente %></td><td data-label="Recibir ahora"><input aria-label="Cantidad recibida de <%= d.SKU %>" class="form-control" data-quantity type="number" min="1" max="<%= d.Pendiente %>" step="1" placeholder="Sin entrega"></td><td data-label="Costo documentado"><input aria-label="Costo documentado de <%= d.SKU %>" class="form-control" data-cost inputmode="decimal" maxlength="20" value="<%= d.CostoUnitario %>"></td></tr><% }); %></tbody></table></div><div class="com-form-footer"><p class="com-help">La confirmación registra existencias y un movimiento por producto. No se permite superar lo pendiente.</p><button class="btn btn-primary" type="submit">Confirmar recepción</button></div></form></section><% } %>
<section class="com-panel com-section com-no-print" id="com-deliveries"><header class="com-section-heading"><div><h2>Recepciones documentadas</h2><p>Entregas confirmadas y referencias de inventario.</p></div></header><% if(recepciones.length){ %><div class="com-table-wrap"><table class="com-table"><thead><tr><th>Documento / fecha</th><th>Producto</th><th>Cantidad</th><th>Costo real</th><th>Responsable</th><th>Referencia</th></tr></thead><tbody><% recepciones.forEach(r=>{ %><tr><th scope="row"><%= r.DocumentoRespaldo %><small><%- include('../partials/operational-date',{value:r.FechaHora}) %></small></th><td data-label="Producto"><%= r.Descripcion %><small><%= r.Motivo %></small></td><td data-label="Cantidad"><%= r.Cantidad %></td><td data-label="Costo real" class="com-money"><%= comMoney(r.CostoDocumentado) %></td><td data-label="Responsable"><%= r.Actor %></td><td data-label="Referencia">Recepción <%= r.RecepcionId %><small>Kardex <%= r.KardexId %></small></td></tr><% }); %></tbody></table></div><% }else{ %><p class="com-empty-inline">Todavía no se han registrado entregas para esta orden.</p><% } %><%- include('detail-pager',{kind:'entregas'}) %></section>
<section class="com-history com-no-print" id="com-history"><h2>Historial de la orden</h2><ol><% historial.forEach(h=>{ %><li><span class="com-timeline-dot"></span><div><strong><%= labels[h.EstadoNuevo] %></strong><p><%= h.Motivo %></p><small>Usuario <%= h.ActorUsuarioId %> · <%- include('../partials/operational-date',{value:h.FechaHora}) %></small></div></li><% }); %></ol><%- include('detail-pager',{kind:'historial'}) %></section><%- include('foot') %>
