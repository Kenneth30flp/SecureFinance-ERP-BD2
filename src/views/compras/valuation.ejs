<%- include('head',{title:'Valoración de inventario',subtitle:'Promedio ponderado móvil a partir de movimientos y costos comprobados.'}) %>
<section class="com-panel com-section"><header class="com-panel-heading"><div><p class="eyebrow"><%= producto.Codigo %></p><h2><%= producto.Descripcion %></h2></div><form data-refresh-form action="/compras/valoracion/<%= producto.ProductoId %>/actualizar"><button class="btn btn-primary" type="submit">Actualizar valoración</button></form></header><div class="com-metrics"><div><span>Existencias actuales</span><strong><%= producto.Stock %></strong></div><div><span>Promedio al corte</span><strong><%= comMoney(producto.Promedio) %></strong></div><div><span>Valor al corte</span><strong><%= comMoney(producto.Valor) %></strong></div></div><p class="com-message"><%= producto.Actualizada?'Corte actualizado con el último movimiento disponible.':'Hay movimientos pendientes de valorar o no se ha generado un corte. Pulsa Actualizar valoración.' %> <%= producto.Completa?'Los costos del saldo al corte están comprobados.':'Valoración incompleta: no se asignan costos ficticios a existencias históricas, ajustes o devoluciones sin respaldo.' %></p><p class="com-help">La actualización genera el historial auxiliar; no cambia existencias, el costo de catálogo ni los movimientos originales.</p></section>
<section class="com-panel com-section"><h2>Historial de valoración</h2><div class="com-table-wrap"><table class="com-table"><caption class="visually-hidden">Valoración por movimiento Kardex</caption><thead><tr><th>Movimiento</th><th>Cantidad / saldo</th><th>Costo aplicado</th><th>Promedio</th><th>Valor del saldo</th><th>Comprobación</th></tr></thead><tbody><% movimientos.forEach(m=>{ %><tr><th scope="row"><%= m.TipoMovimiento %> #<%= m.KardexId %><small><%- include('../partials/operational-date',{value:m.FechaHora}) %></small></th><td data-label="Cantidad / saldo"><%= m.Cantidad %> / <%= m.StockResultante %></td><td data-label="Costo aplicado" class="com-money"><%= comMoney(m.CostoAplicado) %></td><td data-label="Promedio" class="com-money"><%= comMoney(m.Promedio) %></td><td data-label="Valor" class="com-money"><%= comMoney(m.Valor) %></td><td data-label="Comprobación"><%= m.Razon %></td></tr><% }); %></tbody></table></div><% if(!movimientos.length){ %><p class="com-empty-inline">No hay valoraciones registradas. Actualiza para revisar los movimientos disponibles.</p><% } %><nav class="com-pagination" aria-label="Paginación"><span>Página <%= f.pagina %></span><div><% if(f.pagina>1){ %><a href="?pagina=<%= f.pagina-1 %>">← Anterior</a><% } %><% if(next){ %><a href="?pagina=<%= f.pagina+1 %>">Siguiente →</a><% } %></div></nav></section><%- include('foot') %>
