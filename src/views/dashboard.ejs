<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/visual.js" defer></script>
</head>
<body class="app-shell dashboard-workspace">
<a class="skip-link" href="#workspace">Ir al contenido</a>
  <%- include('partials/navigation', { actual: 'dashboard', rolesCuenta: resumen?.RolesActuales || '' }) %>
  <main tabindex="-1" id="workspace" class="container dashboard-content page-content">
    <div class="page-header"><p class="eyebrow">Financial operations command center</p><h1>Centro de operaciones</h1><p>Bienvenido, <strong><%= usuario.nombreUsuario %></strong>. Tu escritorio de gestión financiera.</p></div>
    <div class="session-strip"><span class="session-state">Sesión activa</span><span><strong><%= usuario.permisos.length %></strong> permisos asignados</span></div>
    <% const agrupar = (valor) => String(valor).replace(/\B(?=(\d{3})+(?!\d))/g, ','); %>
    <% const dinero = (valor) => { const [entero, centavos] = valor.split('.'); return 'Q ' + agrupar(entero) + '.' + centavos; }; %>
    <% if (advertencia) { %><div class="alert desk-message alert-warning" data-marker="!" role="status"><%= advertencia %></div><% } %>
    <section class="dashboard-overview" aria-labelledby="resumen-operativo-title">
      <div class="overview-heading"><h2 id="resumen-operativo-title">Pulso operativo</h2><p><%= resumen?.FechaOperacion || 'Resumen no disponible' %> · Jornada Guatemala / UTC−6</p></div>
      <dl class="dashboard-kpis">
        <% [['VentasDia', 'Ventas del día', 'Ventas registradas'], ['FacturasDia', 'Facturas emitidas hoy', 'Documentos emitidos'], ['ProductosStockBajo', 'Productos con stock bajo', 'Activos con stock ≤ 5'], ['EventosDMLDia', 'Eventos de auditoría hoy', 'Eventos DML registrados']].forEach(([campo, titulo, ayuda]) => { %>
          <div class="kpi-card"><dt><%= titulo %></dt><dd><%= resumen?.[campo] == null ? '—' : campo === 'VentasDia' ? dinero(resumen[campo]) : agrupar(resumen[campo]) %></dd><dd class="kpi-caption"><%= !resumen ? 'Temporalmente no disponible' : resumen[campo] == null ? 'Sin permiso de consulta' : ayuda %></dd></div>
        <% }); %>
      </dl>
    </section>
    <div class="command-secondary"><section class="operations-directory" aria-label="Operaciones disponibles"><div class="directory-heading"><h2>Entra en operación</h2><p>Herramientas habilitadas para tu cuenta.</p></div><div class="module-grid">
    <% if (usuario.permisos.includes('VENTAS_REGISTRAR')) { %>
      <a class="module-card module-sales" href="/facturacion"><span class="module-icon"><%- include('partials/icon',{nombre:'receipt'}) %></span><span class="eyebrow">Ventas y caja</span><h2>Facturación</h2><p>Prepara la venta. Verifica las existencias. Procesa la operación.</p><span class="module-action">Registrar venta <span aria-hidden="true">&rarr;</span></span></a>
    <% } %>
    <% if (usuario.permisos.includes('AUDITORIA_CONSULTAR')) { %>
      <a class="module-card module-audit" href="/auditoria"><span class="module-icon"><%- include('partials/icon',{nombre:'shield'}) %></span><span class="eyebrow">Control y trazabilidad</span><h2>Auditoría</h2><p>Accesos, cambios y eventos.<br>La trazabilidad de cada operación.</p><span class="module-action">Consultar auditoría <span aria-hidden="true">&rarr;</span></span></a>
    <% } %>
    </div></section>
    <section class="access-profile" aria-labelledby="permisos-title">
      <div class="profile-body">
        <h2 class="h5 mb-3" id="permisos-title">Perfil de acceso</h2>
        <p class="text-secondary small">Alcance de acceso asignado a tu cuenta.</p>
        <% if (usuario.permisos.length) { %>
          <ul class="permission-list">
            <% usuario.permisos.forEach((permiso) => { %>
              <li class="permission-badge"><%= permiso %></li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="text-secondary mb-0">No tienes permisos activos asignados.</p>
        <% } %>
      </div>
    </section></div>
  </main>
</body>
</html>
