<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ingresar | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/visual.js" defer></script>
</head>
<body class="login-page">
  <a class="skip-link" href="#portal-access">Ir al acceso</a>
  <main class="login-portal">
    <%- include('partials/portal-header') %>
    <div class="portal-layout"><%- include('partials/portal-story') %>
    <section id="portal-access" tabindex="-1" class="portal-access" aria-labelledby="access-title"><div class="access-heading"><span class="access-emblem"><%- include('partials/icon',{nombre:'key'}) %></span><p class="access-kicker">Credenciales de cuenta</p><h2 id="access-title">Bienvenido de nuevo</h2><p>Ingresa con tu cuenta para continuar al espacio financiero.</p></div>
      <% if (error) { %>
        <div class="alert desk-message alert-danger" data-marker="×" role="alert"><%= error %></div>
      <% } %>
      <form method="post" action="/login">
        <div class="mb-3">
          <label class="form-label" for="usuario">Usuario</label>
          <input class="form-control" id="usuario" name="NombreUsuario" type="text"
                 value="<%= nombreUsuario %>" autocomplete="username" maxlength="50" required autofocus>
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Contraseña</label>
          <input class="form-control" id="password" name="Password" type="password"
                 autocomplete="current-password" maxlength="128" required>
          <a class="access-link" href="/recuperar-password">¿Olvidaste tu contraseña?</a>
        </div>
        <button class="btn btn-primary w-100 py-2" type="submit">Ingresar</button>
      </form>
    </section>
    </div>
    <footer class="portal-footer"><span>SECUREFINANCE ERP</span><span>Operación / Control / Trazabilidad</span></footer>
  </main>
</body>
</html>
