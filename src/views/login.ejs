<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ingresar | SecureFinance ERP</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="login-page">
  <main class="login-portal">
    <header class="portal-header"><a class="brand-title" href="/login"><svg class="brand-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M23 8H9v15h14v17H7M30 40V8h13M30 23h11" stroke="currentColor" stroke-width="4"/><path d="M7 31h9M37 33h6" stroke="var(--copper-soft)" stroke-width="3"/></svg><span>SecureFinance<small>ERP / Financial operations desk</small></span></a><span class="portal-reference">PORTAL DE ACCESO</span></header>
    <div class="portal-title"><p class="eyebrow">OPERACIONES FINANCIERAS</p><h1>El control empieza<br>en cada operación.</h1><p>Ventas, caja y trazabilidad en un mismo espacio de trabajo.</p></div>
    <section class="portal-access" aria-labelledby="access-title"><div class="access-heading"><span class="section-index">01 / ACCESO</span><h2 id="access-title">Ingresa a tu escritorio</h2><p>Utiliza tu cuenta de SecureFinance ERP.</p></div>
      <% if (error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <form method="post" action="/login">
        <div class="mb-3">
          <label class="form-label" for="usuario">Usuario</label>
          <input class="form-control" id="usuario" name="NombreUsuario" type="text"
                 value="<%= nombreUsuario %>" autocomplete="username" maxlength="50" required autofocus>
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Contraseña</label>
          <input class="form-control" id="password" name="Password" type="password"
                 autocomplete="current-password" maxlength="128" required>
        </div>
        <button class="btn btn-primary w-100 py-2" type="submit">Ingresar</button>
      </form>
    </section>
    <footer class="portal-footer"><span>SECUREFINANCE ERP</span><span>Operación / Control / Trazabilidad</span></footer>
  </main>
</body>
</html>
