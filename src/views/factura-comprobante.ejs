<%- include('partials/facturas-head',{title:'Comprobante #'+factura.FacturaId,autoPrint}) %>
<section id="invoice-copy" class="work-panel sale-receipt invoice-copy" aria-labelledby="invoice-title"><div class="panel-body"><div class="receipt-heading"><div><p class="eyebrow">SECUREFINANCE ERP / COPIA DE COMPROBANTE INTERNO</p><h2 id="invoice-title">Factura #<%= factura.FacturaId %></h2></div><span class="status-badge"><%= factura.Estado %></span></div>
<dl class="receipt-information"><dt>Cliente de emisión</dt><dd><%= factura.Cliente||'No registrado al emitir' %></dd><dt>NIT de emisión</dt><dd><%= factura.NIT||'No registrado al emitir' %></dd><dt>Responsable</dt><dd><%= factura.Responsable %></dd><dt>Fecha · Guatemala (UTC−6)</dt><dd><%- include('partials/operational-date',{value:factura.FechaHora}) %></dd><dt>Motivo del descuento</dt><dd><%= factura.MotivoDescuento||'Sin motivo registrado' %></dd><dt>Estado documental</dt><dd><%= factura.Estado %></dd></dl>
<div class="table-responsive"><table class="table table-modern receipt-table invoice-lines"><caption>Detalle persistido de la venta · precios unitarios sin IVA</caption><thead><tr><th>SKU / producto</th><th>Cantidad</th><th>Precio histórico Q</th><th>Subtotal Q</th><th>Descuento %</th><th>Descuento Q</th><th>Subtotal neto Q</th></tr></thead><tbody><% detalle.forEach(d=>{ %><tr data-line="<%= d.DetalleFacturaId %>"><td><strong><%= d.Codigo %></strong><br><%= d.Descripcion %><% if(d.ReferenciaCatalogo){ %><br><small>SKU / nombre de referencia del catálogo</small><% } %></td><td><%= d.Cantidad %></td><td><%= displayMoney(d.PrecioUnitario) %></td><td><%= displayMoney(d.Subtotal) %></td><td><%= d.DescuentoPorcentaje %></td><td><%= displayMoney(d.DescuentoMonto) %></td><td><%= displayMoney(d.SubtotalNeto) %></td></tr><% }); %></tbody></table></div>
<% const promosFactura=typeof promocionesAplicadas!=='undefined'?promocionesAplicadas:[]; if(promosFactura.length){ const nombres=Object.fromEntries(detalle.map(d=>[d.ProductoId,d.Descripcion])); %><div class="table-responsive invoice-promotions"><table class="table table-modern receipt-table"><caption>Promociones aplicadas al emitir · regla conservada en la factura</caption><thead><tr><th>Producto</th><th>Promoción</th><th>Unidades bonificadas</th><th>Descuento aplicado Q</th></tr></thead><tbody><% promosFactura.forEach(a=>{ %><tr data-promotion="<%= a.PromocionId %>"><td><%= nombres[a.ProductoId]||('Producto '+a.ProductoId) %></td><td><strong><%= a.Codigo %></strong><br><%= a.Promocion %></td><td><%= a.UnidadesBonificadas %></td><td><%= displayMoney(a.DescuentoMonto) %> (<%= a.DescuentoPorcentaje %>%)</td></tr><% }); %></tbody></table></div><% } %>
<% if(detalle.some(d=>d.ReferenciaCatalogo)){ %><p class="summary-note">Este documento es anterior a la captura completa de SKU y descripción de emisión. Las líneas indicadas usan la referencia disponible del catálogo; todos los importes proceden de la factura original.</p><% } %>
<dl class="sale-totals receipt-totals"><dt>Subtotal bruto</dt><dd><%= displayMoney(factura.Subtotal) %></dd><dt>Descuento</dt><dd><%= displayMoney(factura.Descuento) %></dd><dt>Subtotal neto</dt><dd><%= displayMoney(factura.SubtotalNeto) %></dd><dt>IVA registrado</dt><dd><%= displayMoney(factura.IVA) %></dd><dt class="total-label">Total final</dt><dd class="money-total" id="invoice-total"><%= displayMoney(factura.Total) %></dd></dl>
<p class="summary-note invoice-disclaimer">Copia de comprobante interno / académico. No es una factura electrónica certificada SAT/FEL. La reimpresión no registra una venta ni modifica inventario o caja.</p>
<div class="receipt-actions"><a class="btn btn-outline-secondary" href="/facturacion/historial">Volver al historial</a><button class="btn btn-primary" type="button" id="print-invoice">Imprimir copia</button></div></div></section></main></body></html>
