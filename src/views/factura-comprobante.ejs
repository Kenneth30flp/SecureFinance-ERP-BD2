<%- include('partials/facturas-head',{title:'Comprobante #'+factura.FacturaId,autoPrint}) %>
<section id="invoice-copy" class="work-panel sale-receipt invoice-copy" aria-labelledby="invoice-title"><div class="panel-body"><div class="receipt-heading"><div><p class="eyebrow">SECUREFINANCE ERP / COPIA DE COMPROBANTE INTERNO</p><h2 id="invoice-title">Factura #<%= factura.FacturaId %></h2></div><span class="status-badge"><%= factura.Estado %></span></div>
<dl class="receipt-information"><dt>Cliente de emisión</dt><dd><%= factura.Cliente||'No registrado al emitir' %></dd><dt>NIT de emisión</dt><dd><%= factura.NIT||'No registrado al emitir' %></dd><dt>Responsable</dt><dd><%= factura.Responsable %></dd><dt>Fecha · Guatemala (UTC−6)</dt><dd><%- include('partials/operational-date',{value:factura.FechaHora}) %></dd><dt>Motivo del descuento</dt><dd><%= factura.MotivoDescuento||'Sin motivo registrado' %></dd><dt>Estado documental</dt><dd><%= factura.Estado %></dd></dl>
<div class="table-responsive"><table class="table table-modern receipt-table invoice-lines"><caption>Detalle persistido de la venta · precios unitarios sin IVA</caption><thead><tr><th>SKU / producto</th><th>Cantidad</th><th>Precio histórico Q</th><th>Subtotal Q</th><th>Descuento %</th><th>Descuento Q</th><th>Subtotal neto Q</th></tr></thead><tbody><% detalle.forEach(d=>{ %><tr data-line="<%= d.DetalleFacturaId %>"><td><strong><%= d.Codigo %></strong><br><%= d.Descripcion %><% if(d.ReferenciaCatalogo){ %><br><small>SKU / nombre de referencia del catálogo</small><% } %></td><td><%= d.Cantidad %></td><td><%= d.PrecioUnitario %></td><td><%= d.Subtotal %></td><td><%= d.DescuentoPorcentaje %></td><td><%= d.DescuentoMonto %></td><td><%= d.SubtotalNeto %></td></tr><% }); %></tbody></table></div>
<% if(detalle.some(d=>d.ReferenciaCatalogo)){ %><p class="summary-note">Este documento es anterior a la captura completa de SKU y descripción de emisión. Las líneas indicadas usan la referencia disponible del catálogo; todos los importes proceden de la factura original.</p><% } %>
<dl class="sale-totals receipt-totals"><dt>Subtotal bruto</dt><dd>Q <%= factura.Subtotal %></dd><dt>Descuento</dt><dd>Q <%= factura.Descuento %></dd><dt>Subtotal neto</dt><dd>Q <%= factura.SubtotalNeto %></dd><dt>IVA registrado</dt><dd>Q <%= factura.IVA %></dd><dt class="total-label">Total final</dt><dd class="money-total" id="invoice-total">Q <%= factura.Total %></dd></dl>
<p class="summary-note invoice-disclaimer">Copia de comprobante interno / académico. No es una factura electrónica certificada SAT/FEL. La reimpresión no registra una venta ni modifica inventario o caja.</p>
<div class="receipt-actions"><a class="btn btn-outline-secondary" href="/facturacion/historial">Volver al historial</a><button class="btn btn-primary" type="button" id="print-invoice">Imprimir copia</button></div></div></section></main></body></html>
