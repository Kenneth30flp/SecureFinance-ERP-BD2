NODE_ENV=development
PORT=3000
# Generar un secreto aleatorio local de al menos 32 caracteres.
SESSION_SECRET=

# Cuenta SQL dedicada. No utilizar sa.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=REEMPLAZAR_CON_BASE_DE_LABORATORIO_GENERADA
DB_USER=securefinance_app
DB_PASSWORD=
DB_ENCRYPT=true
# Solo para desarrollo local con certificado autofirmado: true.
DB_TRUST_SERVER_CERTIFICATE=false

